class SmiError(Exception):
    pass


# ---------------------------------------------------------------------------
# nvidia-smi access
# ---------------------------------------------------------------------------
def _num(token: str) -> float | None:
    token = token.strip()
    if not token or token in ("[N/A]", "N/A", "[Not Supported]", "Not Supported"):
        return None
    try:
        return float(token)
    except ValueError:
        return None


def _run_query(query_flag: str, fields: list[str]) -> list[list[str]]:
    cmd = [
        NVIDIA_SMI,
        f"--{query_flag}={','.join(fields)}",
        "--format=csv,noheader,nounits",
    ]
    try:
        out = subprocess.run(
            cmd, capture_output=True, text=True, timeout=10
        )
    except FileNotFoundError:
        raise SmiError(
            f"'{NVIDIA_SMI}' not found. Install the NVIDIA driver or set "
            "SPARKTOP_NVIDIA_SMI to its path."
        )
    except subprocess.TimeoutExpired:
        raise SmiError("nvidia-smi timed out.")
    if out.returncode != 0:
        msg = (out.stderr or out.stdout).strip()
        hint = ""
        if "version mismatch" in msg.lower():
            hint = (
                "\n\nThe NVIDIA kernel module and userspace library versions "
                "don't match.\nThis usually happens after a driver update "
                "before a reboot.\nFix it with:  sudo reboot"
            )
        raise SmiError(f"nvidia-smi failed:\n{msg}{hint}")
    return [
        [c.strip() for c in line.split(",")]
        for line in out.stdout.splitlines()
        if line.strip()
    ]


def read_gpus() -> list[Gpu]:
    rows = _run_query("query-gpu", GPU_FIELDS)
    gpus = []
    for r in rows:
        if len(r) < len(GPU_FIELDS):
            continue
        gpus.append(
            Gpu(
                index=r[0],
                name=r[1],
                driver=r[2],
                temp=_num(r[3]),
                util_gpu=_num(r[4]),
                util_mem=_num(r[5]),
                mem_total=_num(r[6]),
                mem_used=_num(r[7]),
                mem_free=_num(r[8]),
                power_draw=_num(r[9]),
                power_limit=_num(r[10]),
                clock_sm=_num(r[11]),
                pstate=r[12],
            )
        )
    # Unified-memory fallback: when nvidia-smi exposes no VRAM (GB10/Grace
    # systems like the DGX Spark), fill memory from the shared system pool.
    if any(g.mem_total is None for g in gpus):
        sys_total, sys_used = read_meminfo()
        if sys_total is not None:
            for g in gpus:
                if g.mem_total is None:
                    g.mem_total = sys_total
                    g.mem_used = sys_used
                    g.mem_free = sys_total - (sys_used or 0)
                    g.mem_unified = True
    return gpus


def read_meminfo() -> tuple[float | None, float | None]:
    """Return (total_mib, used_mib) from /proc/meminfo, or (None, None).

    On unified-memory platforms like the DGX Spark, the GPU has no dedicated
    VRAM, so nvidia-smi reports [N/A] for every memory field; the GPU instead
    allocates from the shared system pool. We approximate "used" the same way
    `free` does: MemTotal - MemAvailable.
    """
    vals: dict[str, float] = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                key, _, rest = line.partition(":")
                if key in ("MemTotal", "MemAvailable"):
                    vals[key] = float(rest.split()[0]) / 1024  # kB -> MiB
                    if len(vals) == 2:
                        break
    except (OSError, ValueError, IndexError):
        return None, None
    total, avail = vals.get("MemTotal"), vals.get("MemAvailable")
    if total is None or avail is None:
        return None, None
    return total, total - avail


def read_procs() -> list[Proc]:
    try:
        rows = _run_query("query-compute-apps", PROC_FIELDS)
    except SmiError:
        return []
    procs = []
    for r in rows:
        if len(r) < 3:
            continue
        procs.append(Proc(pid=r[0], name=r[1], mem=_num(r[2])))
    return procs


# ---------------------------------------------------------------------------
# systemd services
# ---------------------------------------------------------------------------
def _run(cmd: list[str], timeout: float = 5.0) -> str | None:
    """Run a command, returning stdout, or None if it isn't usable.

    Unlike nvidia-smi, none of these sources are essential — a box without
    systemd, ss or docker just shows fewer panes.
    """
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return None
    if out.returncode != 0:
        return None
    return out.stdout


# Unit files shipped by the distro live here; anything else is hand-written.
VENDOR_UNIT_DIRS = ("/usr/lib/systemd/", "/lib/systemd/", "/run/systemd/", "/usr/local/lib/systemd/")

SERVICE_PROPS = ["Id", "FragmentPath", "MainPID", "ActiveState", "SubState"]


def _parse_show(text: str) -> list[dict[str, str]]:
    """Split `systemctl show` output into one dict per blank-line-separated record."""
    records, cur = [], {}
    for line in text.splitlines():
        if not line.strip():
            if cur:
                records.append(cur)
                cur = {}
            continue
        key, _, val = line.partition("=")
        cur[key] = val
    if cur:
        records.append(cur)
    return records


def _read_services_scope(scope: str) -> list[Service] | None:
    cmd = ["systemctl"]
    if scope == "user":
        cmd.append("--user")
    cmd += ["show", "*.service", f"--property={','.join(SERVICE_PROPS)}", "--no-pager"]
    text = _run(cmd)
    if text is None:
        return None  # no systemd, or no user bus on this login
    services = []
    for rec in _parse_show(text):
        unit, path = rec.get("Id", ""), rec.get("FragmentPath", "")
        # "Yours" = a unit file you wrote. Vendor units live under /usr/lib or
        # /lib; snap generates its own into /etc/systemd/system, so drop those
        # by name. Units with no fragment at all are aliases/generated.
        if not unit or not path or unit.startswith("snap."):
            continue
        if path.startswith(VENDOR_UNIT_DIRS):
            continue
        services.append(
            Service(
                unit=unit,
                scope=scope,
                state=rec.get("ActiveState", ""),
                sub=rec.get("SubState", ""),
                pid=rec.get("MainPID", "0"),
            )
        )
    return services


# Sort key: problems first, then things that are up, then the quiet ones.
STATE_RANK = {"failed": 0, "activating": 1, "deactivating": 1, "active": 2}


def read_services() -> list[Service] | None:
    scopes = [_read_services_scope("system"), _read_services_scope("user")]
    if all(s is None for s in scopes):
        return None
    services = [s for scope in scopes if scope for s in scope]
    services.sort(
        key=lambda s: (
            STATE_RANK.get(s.state, 3),
            s.sub != "running",
            s.scope != "user",
            s.short,
        )
    )
    return services


# ---------------------------------------------------------------------------
# Listening ports
# ---------------------------------------------------------------------------
DEFAULT_PORT_SPEC = os.environ.get(
    "SPARKTOP_PORTS",
    "3000-3009,4000-4009,4321-4322,5000-5009,5173-5183,5432,6379,7860,"
    "8000-8199,8888,9090,11434,19132,25565,25575,27017",
)


def parse_port_spec(spec: str) -> list[tuple[int, int]]:
    """Turn "3000-3009,8080,25565" into [(3000, 3009), (8080, 8080), ...]."""
    ranges: list[tuple[int, int]] = []
    for chunk in spec.split(","):
        chunk = chunk.strip()
        if not chunk:
            continue
        lo_s, _, hi_s = chunk.partition("-")
        try:
            lo = int(lo_s)
            hi = int(hi_s) if hi_s else lo
        except ValueError:
            raise ValueError(f"bad port spec: {chunk!r}")
        if not (0 < lo <= hi <= 65535):
            raise ValueError(f"bad port range: {chunk!r}")
        ranges.append((lo, hi))
    return ranges


def _in_ranges(port: int, ranges: list[tuple[int, int]]) -> bool:
    return any(lo <= port <= hi for lo, hi in ranges)


def _loopback(host: str) -> bool:
    return host.startswith("127.") or host in ("::1", "localhost")


def _split_hostport(addr: str) -> tuple[str, int] | None:
    """Split an ss local address ("127.0.0.1:8080", "[::]:22", "*:9090")."""
    host, sep, port_s = addr.rpartition(":")
    if not sep:
        return None
    try:
        port = int(port_s)
    except ValueError:
        return None
    host = host.partition("%")[0]  # drop the "%lo" scope suffix
    if host.startswith("[") and host.endswith("]"):
        host = host[1:-1]
    return host, port


def _pid_from_users(field: str) -> tuple[str, str] | None:
    """Pull (pid, name) out of ss's `users:(("nginx",pid=42,fd=6))` column."""
    m = re.search(r'\(\("([^"]*)",pid=(\d+)', field)
    return (m.group(2), m.group(1)) if m else None


# A container's processes live in /system.slice/docker-<full id>.scope.
DOCKER_SCOPE = re.compile(r"docker-([0-9a-f]{12,64})\.scope")


def cgroup_owner(pid: str) -> tuple[str | None, str | None]:
    """Map a PID to its (systemd unit, docker container id) via its cgroup.

    /proc/<pid>/cgroup is world-readable, so this works for other users'
    processes too — unlike ss, which only names PIDs you own.
    """
    try:
        with open(f"/proc/{pid}/cgroup") as f:
            data = f.read()
    except OSError:
        return None, None
    m = DOCKER_SCOPE.search(data)
    if m:
        return None, m.group(1)
    for part in reversed(data.replace("\n", "/").split("/")):
        if part.endswith(".service") and not part.startswith(("user@", "init")):
            return part, None
    return None, None


# The listening state in /proc/net: TCP_LISTEN for tcp, TCP_CLOSE for udp.
PROC_NET_LISTEN = {"tcp": "0A", "tcp6": "0A", "udp": "07", "udp6": "07"}


def read_socket_uids() -> dict[tuple[str, int], int]:
    """Map (proto, port) to the uid that owns the socket, from /proc/net.

    ss only names PIDs you own, but /proc/net always exposes each socket's
    uid. That's enough to say *whose* a port is even when the process behind
    it can't be identified — a root-owned port says so instead of just "?".
    """
    uids: dict[tuple[str, int], int] = {}
    for fname, listening in PROC_NET_LISTEN.items():
        try:
            with open(f"/proc/net/{fname}") as f:
                next(f, None)  # column header
                for line in f:
                    parts = line.split()
                    if len(parts) < 8 or parts[3] != listening:
                        continue
                    try:
                        port = int(parts[1].rpartition(":")[2], 16)
                        uid = int(parts[7])
                    except ValueError:
                        continue
                    # v4 and v6 share a port; either owner answers the question.
                    uids.setdefault((fname.rstrip("6"), port), uid)
        except OSError:
            continue
    return uids


def username(uid: int) -> str:
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return f"uid{uid}"


# "0.0.0.0:25567->8080/tcp", or a run of them: "[::]:8000-8002->8000-8002/tcp".
DOCKER_PUBLISHED = re.compile(
    r"(\[[^\]]+\]|[\d.]+):(\d+)(?:-(\d+))?->(\d+)(?:-\d+)?/(\w+)"
)


def read_docker() -> Docker:
    """Ask docker which containers are running and what they publish.

    Both maps are needed because containers reach the host's ports two ways:
    a published port is proxied by a root-owned docker-proxy, so only the port
    number identifies it; a `network_mode: host` container instead listens on
    the host directly, so its own PID's cgroup names it — if ss can see it.
    The LLMs pane goes the other way, from a port inside a container to the
    one it's published on.
    """
    text = _run(
        [
            "docker", "ps", "--no-trunc", "--format",
            "{{.ID}}\t{{.Names}}\t{{.Networks}}\t{{.Ports}}",
        ],
        timeout=3.0,
    )
    docker = Docker()
    if not text:
        return docker
    for line in text.splitlines():
        cid, name, networks, portspec = (line.split("\t") + ["", "", ""])[:4]
        if not name:
            continue
        docker.names[cid] = name
        if networks == "host":
            docker.host_net.add(name)
        # Bare "5001/tcp" is merely exposed and isn't listening on the host,
        # so only the "host:port->port" form counts.
        for m in DOCKER_PUBLISHED.finditer(portspec):
            host = m.group(1).strip("[]")
            if host in ("0.0.0.0", "::"):  # a wildcard answers on loopback too
                host = "::1" if host == "::" else "127.0.0.1"
            lo = int(m.group(2))
            hi = int(m.group(3) or lo)
            inner = int(m.group(4))
            for i, port in enumerate(range(lo, hi + 1)):
                docker.ports.setdefault(port, name)
                if m.group(5) != "tcp":
                    continue
                fwd = docker.forwards.setdefault(name, {})
                # Published on several addresses: loopback is the one to use.
                have = fwd.get(inner + i)
                if have is None or (_loopback(host) and not _loopback(have[0])):
                    fwd[inner + i] = (host, port)
    return docker


def read_listeners(
    ranges: list[tuple[int, int]],
    docker_ports: dict[int, str],
    docker_names: dict[str, str],
) -> list[Listener] | None:
    # -tu gives a leading netid column, so the layout is the same either way.
    text = _run(["ss", "-H", "-tulnp"], timeout=5.0)
    if text is None:
        return None  # no iproute2
    found: dict[tuple[str, int], Listener] = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 5:
            continue
        proto, state, local = parts[0], parts[1], parts[4]
        if state not in ("LISTEN", "UNCONN"):
            continue
        hp = _split_hostport(local)
        if hp is None:
            continue
        host, port = hp
        if not _in_ranges(port, ranges):
            continue
        key = (proto, port)
        lis = found.get(key)
        if lis is None:
            lis = found[key] = Listener(port=port, proto=proto, binds=set())
        lis.binds.add(host)
        if lis.pid is None and len(parts) > 6:
            got = _pid_from_users(parts[6])
            if got:
                lis.pid, lis.proc = got
                lis.unit, cid = cgroup_owner(lis.pid)
                if cid:
                    lis.container = docker_names.get(cid) or docker_names.get(cid[:12])
    uids = read_socket_uids()
    for (proto, port), lis in found.items():
        # Only fall back to the published-port map when we learned nothing
        # useful: either ss named nobody (docker-proxy is root-owned, the usual
        # case) or it named docker.service, which is true but says nothing.
        if lis.container is None and port in docker_ports and (
            lis.unit == "docker.service" or (lis.unit is None and lis.proc is None)
        ):
            lis.unit = None
            lis.container = docker_ports[port]
        lis.uid = uids.get((proto, port))
    return sorted(found.values(), key=lambda l: (l.port, l.proto))


# ---------------------------------------------------------------------------
# Local LLM servers
# ---------------------------------------------------------------------------
# A model server is recognised by the program it runs, never by a word turning
# up somewhere in a command line — `grep llama-server` or `vim vllm.md` is not
# a model. The program is a binary's name, a Python script's, or the module
# behind `python -m` (see _program). A key with a space in it also needs the
# subcommand: `ollama serve` is the server, `ollama run` just a client of it.
#
# The port is the engine's default, for when the command line doesn't give
# one; None means the program has no API to ask.
LLM_PROGRAMS: dict[str, tuple[str, int | None]] = {
    "llama-server": ("llama.cpp", 8080),
    "llama-cli": ("llama.cpp", None),
    "llama_cpp.server": ("llama-cpp-python", 8000),
    "ollama serve": ("ollama", 11434),
    "vllm serve": ("vLLM", 8000),
    "vllm.entrypoints.openai.api_server": ("vLLM", 8000),
    "sglang.launch_server": ("SGLang", 30000),
    "trtllm-serve serve": ("TensorRT-LLM", 8000),
    "trtllm-serve": ("TensorRT-LLM", 8000),
    "text-generation-launcher": ("TGI", 3000),
    "koboldcpp": ("KoboldCpp", 5001),
}

# Flags that name the model, across the engines above.
LLM_MODEL_FLAGS = ("-m", "--model", "--model-path", "--model-id", "-hf", "--hf-repo")

# Long enough for a server on loopback, short enough not to hold up a frame.
LLM_PROBE_TIMEOUT = 0.3

PYTHON = re.compile(r"python[\d.]*")


def _program(argv: list[str]) -> tuple[str, list[str]] | None:
    """Name the program a command line runs, and the arguments it was given.

    `python -m vllm.entrypoints.openai.api_server` runs that module and
    `python /usr/local/bin/vllm serve` runs `vllm`, so for an interpreter the
    program is the module or the script, not python itself.
    """
    if not argv:
        return None  # kernel thread
    prog, args = os.path.basename(argv[0]), argv[1:]
    if not PYTHON.fullmatch(prog):
        return prog, args
    i = 0
    while i < len(args) and args[i].startswith("-"):
        if args[i] == "-m":
            return (args[i + 1], args[i + 2 :]) if i + 1 < len(args) else None
        if args[i] == "-c":
            return None  # inline code, e.g. multiprocessing's spawn_main
        i += 2 if args[i] in ("-W", "-X") else 1
    if i == len(args):
        return None  # a bare REPL
    return os.path.basename(args[i]).removesuffix(".py"), args[i + 1 :]


def _flag(args: list[str], names: tuple[str, ...]) -> str | None:
    """The value given for any of `names`, as `--name v` or `--name=v`."""
    for i, a in enumerate(args):
        name, eq, val = a.partition("=")
        if name in names:
            if eq:
                return val
            if i + 1 < len(args):
                return args[i + 1]
    return None


def _model_name(spec: str) -> str:
    """A short name for a model path or repo id.

    "/models/x/Qwen3-8B-Q4_K_M.gguf" and "Qwen/Qwen3-8B" are both best
    known by their last part; split GGUFs drop their "-00001-of-00003" too.
    """
    name = os.path.basename(spec.rstrip("/")) or spec
    return re.sub(r"(-\d{5}-of-\d{5})?\.gguf$", "", name, flags=re.I)


def _llm_match(argv: list[str]) -> tuple[str, str | None, str | None, int | None] | None:
    """(engine, model, host, port) if this command line is a model server."""
    prog = _program(argv)
    if prog is None:
        return None
    name, args = prog
    if args and f"{name} {args[0]}" in LLM_PROGRAMS:
        engine, port = LLM_PROGRAMS[f"{name} {args[0]}"]
        args = args[1:]
    elif name in LLM_PROGRAMS:
        engine, port = LLM_PROGRAMS[name]
    else:
        return None
    model = _flag(args, LLM_MODEL_FLAGS)
    if model is None and args and not args[0].startswith("-"):
        model = args[0]  # positional, as in `vllm serve Qwen/Qwen3-8B`
    if port is not None:
        try:
            port = int(_flag(args, ("--port",)) or port)
        except ValueError:
            pass
    host = _flag(args, ("--host",))
    return engine, (_model_name(model) if model else None), host, port


def _proc_table() -> dict[str, tuple[str, list[str]]] | None:
    """pid -> (parent pid, argv) for every process we can see.

    Both files are world-readable, so root's servers — anything in a
    container, say — are found as readily as our own.
    """
    try:
        entries = os.listdir("/proc")
    except OSError:
        return None
    table: dict[str, tuple[str, list[str]]] = {}
    for pid in entries:
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                raw = f.read()
            with open(f"/proc/{pid}/stat") as f:
                stat = f.read()
        except OSError:
            continue  # exited while we looked
        # The process name comes first, in parentheses that it can contain.
        fields = stat.rpartition(")")[2].split()
        if len(fields) < 2:
            continue
        argv = [a.decode("utf-8", "replace") for a in raw.split(b"\0") if a]
        table[pid] = (fields[1], argv)
    return table


def _llm_addr(
    host: str | None, port: int | None, container: str | None, docker: Docker
) -> tuple[str, int] | None:
    """Where a server's API answers from this host, or None if it can't be reached.

    A server in its own network namespace listens on a port only the
    container can see, so what we want is where that port is published.
    """
    if port is None:
        return None
    if container is None or container in docker.host_net:
        if not host or host in ("0.0.0.0", "::", "*"):
            host = "127.0.0.1"
        return host, port
    return docker.forwards.get(container, {}).get(port)


def find_llm_servers(docker: Docker) -> list[LlmServer] | None:
    table = _proc_table()
    if table is None:
        return None  # no /proc: not Linux
    found = {pid: m for pid, (_, argv) in table.items() if (m := _llm_match(argv))}
    children: dict[str, list[str]] = {}
    for pid, (ppid, _) in table.items():
        children.setdefault(ppid, []).append(pid)

    servers = []
    for pid, (engine, model, host, port) in found.items():
        # A server that another one started is part of it, not a second model.
        ppid, seen = table[pid][0], set()
        while ppid in table and ppid not in found and ppid not in seen:
            seen.add(ppid)
            ppid = table[ppid][0]
        if ppid in found:
            continue
        # Its children too: vLLM's GPU memory belongs to an engine process it
        # spawns, and ollama loads each model into a runner of its own.
        pids, todo = {pid}, [pid]
        while todo:
            for c in children.get(todo.pop(), ()):
                if c not in pids:
                    pids.add(c)
                    todo.append(c)
        unit, cid = cgroup_owner(pid)
        container = None
        if cid:
            container = docker.names.get(cid) or docker.names.get(cid[:12]) or cid[:12]
        servers.append(
            LlmServer(
                engine=engine,
                pid=pid,
                model=model,
                addr=_llm_addr(host, port, container, docker),
                unit=unit,
                container=container,
                pids=pids,
            )
        )
    return servers


def _http_get(addr: tuple[str, int], path: str) -> tuple[int, bytes] | None:
    """GET a model server's API: (status, body), or None if nothing answered.

    A timeout is raised rather than swallowed, since for llama.cpp being too
    busy to answer is itself the answer. http.client rather than urllib, so a
    $http_proxy meant for the outside world never gets in the way.
    """
    conn = http.client.HTTPConnection(addr[0], addr[1], timeout=LLM_PROBE_TIMEOUT)
    try:
        conn.request("GET", path)
        resp = conn.getresponse()
        return resp.status, resp.read(1 << 20)
    except TimeoutError:
        raise
    except (OSError, http.client.HTTPException):
        return None  # refused, reset, or not speaking HTTP
    finally:
        conn.close()


def _json(body: bytes) -> object:
    try:
        return json.loads(body)
    except ValueError:
        return None


def _probe_llamacpp(addr: tuple[str, int]) -> tuple[str, int | None, int | None]:
    """llama-server: (state, slots busy, slots) from /slots."""
    try:
        got = _http_get(addr, "/slots")
    except TimeoutError:
        # /slots is answered between batches, so the usual reason for no
        # answer in time is a long prompt being chewed through.
        return "busy", None, None
    if got is None:
        return "running", None, None
    status, body = got
    if status == 503:
        return "loading", None, None  # every endpoint says so until it's up
    slots = _json(body) if status == 200 else None
    if isinstance(slots, list) and slots:
        # `is_processing` since late 2024; before that, `state` 1 = processing.
        n = sum(
            1 for s in slots
            if isinstance(s, dict) and (s.get("is_processing") or s.get("state") == 1)
        )
        return ("busy" if n else "idle"), n, len(slots)
    return "running", None, None  # started with --no-slots


def _probe_vllm(addr: tuple[str, int]) -> tuple[str, int | None, int | None]:
    """vLLM: (state, requests running, None) from its Prometheus /metrics."""
    try:
        got = _http_get(addr, "/metrics")
    except TimeoutError:
        got = None
    if got is None or got[0] != 200:
        return "running", None, None
    running, seen = 0.0, False
    for line in got[1].decode("utf-8", "replace").splitlines():
        name, brace, _ = line.partition("{")
        if name.partition(" ")[0] != "vllm:num_requests_running":
            continue
        # `name{labels} value`, one per engine; the labels may hold spaces.
        value = line.rpartition("}")[2] if brace else line.partition(" ")[2]
        try:
            running += float(value.split()[0])
            seen = True
        except (ValueError, IndexError):
            continue
    if not seen:
        return "running", None, None
    n = int(running)
    return ("busy" if n else "idle"), n, None


LLM_PROBES = {"llama.cpp": _probe_llamacpp, "vLLM": _probe_vllm}


def _ollama_rows(s: LlmServer, mem: float | None) -> list[Llm]:
    """One row per model ollama has loaded, from /api/ps.

    Its runners don't name the model they hold (they're given a blob path),
    so the API is the only way to say what's in memory.
    """
    try:
        got = _http_get(s.addr, "/api/ps") if s.addr else None
    except TimeoutError:
        got = None
    ps = _json(got[1]) if got and got[0] == 200 else None
    models = ps.get("models") if isinstance(ps, dict) else None
    if not isinstance(models, list):
        return [Llm(s, None, mem, "running")]
    if not models:
        return [Llm(s, None, mem, "idle")]
    rows = []
    for m in models:
        if not isinstance(m, dict):
            continue
        size = m.get("size")
        rows.append(
            Llm(
                s,
                str(m.get("name") or m.get("model") or "?"),
                size / 2**20 if isinstance(size, (int, float)) else None,
                "loaded",
            )
        )
    return rows


def _rss_mib(pid: str) -> float | None:
    try:
        with open(f"/proc/{pid}/status") as f:
            for line in f:
                if line.startswith("VmRSS:"):
                    return float(line.split()[1]) / 1024
    except (OSError, ValueError, IndexError):
        pass
    return None


def read_llms(servers: list[LlmServer], procs: list[Proc]) -> list[Llm]:
    """Ask each server what it's doing; one row per model it serves.

    Memory is what nvidia-smi charges to the server and its children, which
    on the Spark's unified memory is the model's real footprint. A server
    with nothing on the GPU (CPU inference) falls back to its RSS.
    """
    gpu = {p.pid: p.mem for p in procs if p.mem is not None}
    rows: list[Llm] = []
    for s in servers:
        used = [gpu[p] for p in s.pids if p in gpu]
        mem = sum(used) if used else _rss_mib(s.pid)
        if s.engine == "ollama":
            rows += _ollama_rows(s, mem)
            continue
        probe = LLM_PROBES.get(s.engine)
        state, busy, slots = probe(s.addr) if probe and s.addr else ("running", None, None)
        rows.append(Llm(s, s.model, mem, state, busy, slots))
    # Biggest first, and not busy first: rows that swapped places every time
    # a request came and went would be hard to follow.
    rows.sort(key=lambda m: (-(m.mem or 0), m.label))
    return rows


# ---------------------------------------------------------------------------
# Local database (sqlite)
# ---------------------------------------------------------------------------
# sparktop keeps one small sqlite file so that what it sees outlives a run.
# The air sensor is the only thing recorded so far: one row per line the
# board sends, with the usual fields broken out into columns and the whole
# JSON object kept alongside, so nothing the firmware adds later is lost.
#
# The file lives at $SPARKTOP_DB, or $XDG_DATA_HOME/sparktop/sparktop.db
# (~/.local/share/sparktop/sparktop.db). Anything that goes wrong with it is
# a warning at startup, never a reason for the monitor not to run.
DB_SCHEMA = """
CREATE TABLE IF NOT EXISTS air_readings (
    id                INTEGER PRIMARY KEY,
    at                REAL NOT NULL,   -- unix time the line arrived
    src               TEXT,            -- which board, e.g. "feather-1"
    seq               INTEGER,         -- the board's own publish counter
    uptime_s          INTEGER,         -- seconds since the board booted
    co2               REAL,            -- ppm
    temperature       REAL,            -- °C
    relative_humidity REAL,            -- %
    pm1p0             REAL,            -- µg/m³
    pm2p5             REAL,
    pm4p0             REAL,
    pm10p0            REAL,
    voc_index         REAL,            -- Sensirion index, 1-500
    nox_index         REAL,
    raw               TEXT NOT NULL    -- the JSON object as sent
);
CREATE INDEX IF NOT EXISTS air_readings_at ON air_readings (at);
"""
DB_SCHEMA_VERSION = 1

# column -> key in the board's JSON
AIR_DB_COLUMNS = {
    "src": "src",
    "seq": "seq",
    "uptime_s": "uptime_s",
    "co2": "co2",
    "temperature": "temperature",
    "relative_humidity": "relative_humidity",
    "pm1p0": "mass_concentration_pm1p0",
    "pm2p5": "mass_concentration_pm2p5",
    "pm4p0": "mass_concentration_pm4p0",
    "pm10p0": "mass_concentration_pm10p0",
    "voc_index": "voc_index",
    "nox_index": "nox_index",
}


# name in the history answer -> column
AIR_HISTORY_COLUMNS = {
    "co2": "co2",
    "temp": "temperature",
    "rh": "relative_humidity",
    "pm2p5": "pm2p5",
    "pm10": "pm10p0",
    "voc": "voc_index",
    "nox": "nox_index",
}


def default_db_path() -> str:
    env = os.environ.get("SPARKTOP_DB")
    if env:
        return env
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(base, "sparktop", "sparktop.db")


class Db:
    """The local sqlite database.

    Writes are one INSERT per sensor publish (every 30s), so there is no
    batching to speak of. WAL mode plus a busy timeout lets a second sparktop,
    or a `sqlite3` shell poking at history, coexist with the writer. Once a
    statement fails the connection is dropped and every later call is a
    no-op — the dashboard must keep drawing whatever the disk is doing.
    """

    def __init__(self, path: str):
        self.path = path
        self._conn: sqlite3.Connection | None = None

    def open(self) -> str | None:
        """Connect and migrate. Returns an error message instead of raising."""
        try:
            os.makedirs(os.path.dirname(self.path) or ".", exist_ok=True)
            conn = sqlite3.connect(self.path, timeout=1.0, isolation_level=None)
            conn.execute("PRAGMA journal_mode=WAL")
            conn.execute("PRAGMA synchronous=NORMAL")
            conn.executescript(DB_SCHEMA)
            conn.execute(f"PRAGMA user_version={DB_SCHEMA_VERSION}")
        except (OSError, sqlite3.Error) as e:
            return f"{self.path}: {e}"
        self._conn = conn
        return None

    def close(self) -> None:
        if self._conn is not None:
            try:
                self._conn.close()
            except sqlite3.Error:
                pass
        self._conn = None

    def _run(self, sql: str, params: tuple = ()) -> sqlite3.Cursor | None:
        if self._conn is None:
            return None
        try:
            return self._conn.execute(sql, params)
        except sqlite3.Error:
            self.close()  # disk full, file deleted under us, ...: stop trying
            return None

    # -- air ----------------------------------------------------------------
    def latest_air(self) -> tuple[dict | None, float]:
        """The newest reading and when it arrived, or (None, 0.0)."""
        cur = self._run("SELECT at, raw FROM air_readings ORDER BY at DESC LIMIT 1")
        row = cur.fetchone() if cur is not None else None
        if row:
            try:
                reading = json.loads(row[1])
                if isinstance(reading, dict):
                    return reading, float(row[0])
            except (ValueError, TypeError):
                pass
        return None, 0.0

    def air_history(self, since: float, until: float, points: int) -> dict[str, list]:
        """Each column averaged over `points` equal spans of time, oldest first.

        A span with no reading for a column is None there: a gap stays a gap.
        """
        step = (until - since) / points
        out: dict[str, list] = {k: [None] * points for k in AIR_HISTORY_COLUMNS}
        cur = self._run(
            "SELECT CAST((at - ?) / ? AS INTEGER) AS b, "
            # 6553.4 is the SEN55 saying "off the scale", not a measurement
            + ", ".join(
                f"AVG(CASE WHEN {c} < 6553 THEN {c} END)" if c.startswith("pm") else f"AVG({c})"
                for c in AIR_HISTORY_COLUMNS.values()
            )
            + " FROM air_readings WHERE at >= ? AND at < ? GROUP BY b",
            (since, step, since, until),
        )
        for row in cur.fetchall() if cur is not None else ():
            if 0 <= row[0] < points:
                for k, v in zip(AIR_HISTORY_COLUMNS, row[1:]):
                    out[k][row[0]] = None if v is None else round(v, 1)
        return out

    def insert_air(self, reading: dict, at: float) -> None:
        # One publish can arrive twice: by USB and by broadcast, or in two
        # sparktops at once. The board's name and uptime say it is the same.
        src, up = reading.get("src"), reading.get("uptime_s")
        if isinstance(src, str) and isinstance(up, int) and not isinstance(up, bool):
            cur = self._run(
                "SELECT 1 FROM air_readings WHERE at > ? AND src = ? AND uptime_s = ? LIMIT 1",
                (at - 120, src, up),
            )
            if cur is not None and cur.fetchone():
                return
        cols = list(AIR_DB_COLUMNS)
        vals = []
        for col, key in AIR_DB_COLUMNS.items():
            v = reading.get(key)
            want = str if col == "src" else (int, float)
            if isinstance(v, bool) or not isinstance(v, want):
                v = None  # wrong shape for the column; still in `raw`
            vals.append(v)
        self._run(
            f"INSERT INTO air_readings (at, {', '.join(cols)}, raw) "
            f"VALUES (?, {', '.join('?' * len(cols))}, ?)",
            (at, *vals, json.dumps(reading, separators=(",", ":"))),
        )


# ---------------------------------------------------------------------------
# Air-quality sensor (USB serial)
# ---------------------------------------------------------------------------
# An Adafruit Feather ESP32-S3 running the room-monitor firmware prints one
# line every 30 seconds:
#
#     [DATA] {"src":"feather-1","co2":1081,"temperature":24.99, ...}
#
# A field the sensor can't vouch for is omitted rather than sent as zero, so a
# missing key means "warming up", not "measured zero" — hence `n/a` and not 0
# wherever a key is absent below.
AIR_UDP_PORT = 7779  # broadcast.port in the firmware's config.yaml
AIR_BAUD = 115200  # sensor.serial_baud in the firmware's config.yaml

# Auto-detection only ever opens a port whose by-id name says it is one of
# these boards; a printer or a modem on some other /dev/ttyACM* is left alone.
# Point --air-device at the port to override.
AIR_ID_PATTERN = re.compile(r"feather|esp32|adafruit", re.I)

# Keys we recognise. A line carrying none of them isn't a sensor reading.
AIR_KEYS = frozenset(
    {"co2", "temperature", "relative_humidity", "voc_index", "nox_index"}
    | {f"mass_concentration_pm{n}" for n in ("1p0", "2p5", "4p0", "10p0")}
)

# Three missed publishes. Past this a reading is still shown, but marked.
AIR_STALE_AFTER = 95.0


def _air_num(reading: dict, key: str) -> float | None:
    v = reading.get(key)
    return float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) else None


class AirReader:
    """Non-blocking tail of the air sensor's USB serial line.

    There is nothing to poll: the board talks once every 30 seconds, so a
    frame just drains whatever the kernel has buffered for us and keeps the
    newest complete line. Every line is recorded in the database, and the
    newest row is picked up again on start — which is what makes `--once`
    useful, since a freshly opened port shows nothing at all until the
    board's next publish, up to 30s later.

    Read-only and hands-off: the port is opened O_RDONLY with CLOCAL set, so
    running this alongside a serial monitor is fine and the board is never
    reset or written to.
    """

    RETRY = 5.0  # how often to go looking for the port again once it's gone

    def __init__(self, device: str | None = None, db: Db | None = None, udp_port: int = 0):
        self._device = device  # explicit path, or None to auto-detect
        self._db = db
        # A board on WiFi broadcasts the same JSON to the subnet, so one that
        # is plugged into a wall rather than this machine is heard that way.
        self._udp: socket.socket | None = None
        if udp_port:
            try:
                u = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                u.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)  # a second sparktop hears it too
                u.bind(("", udp_port))
                u.setblocking(False)
                self._udp = u
            except OSError:
                self._udp = None  # the port is taken: USB only
        self._fd: int | None = None
        self._buf = b""
        self._probed = 0.0
        self._reading, self._at = db.latest_air() if db else (None, 0.0)

    # -- the port -----------------------------------------------------------
    def _discover(self) -> str | None:
        if self._device:
            return self._device if os.path.exists(self._device) else None
        for path in sorted(glob.glob("/dev/serial/by-id/*")):
            if AIR_ID_PATTERN.search(os.path.basename(path)):
                return path
        return None

    def _open(self) -> None:
        path = self._discover()
        if not path:
            return
        try:
            import termios
        except ImportError:
            return
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NOCTTY | os.O_NONBLOCK)
        except OSError:
            return  # unplugged mid-probe, or we're not in the dialout group
        try:
            # Raw, no flow control, and CLOCAL so a dropped carrier doesn't
            # hang up on us. VMIN/VTIME 0 keeps every read non-blocking.
            cc = list(termios.tcgetattr(fd)[6])
            cc[termios.VMIN] = 0
            cc[termios.VTIME] = 0
            speed = getattr(termios, f"B{AIR_BAUD}")
            termios.tcsetattr(
                fd,
                termios.TCSANOW,
                [0, 0, termios.CS8 | termios.CREAD | termios.CLOCAL, 0,
                 speed, speed, cc],
            )
        except Exception:
            os.close(fd)
            return
        self._fd, self._buf = fd, b""

    def close(self) -> None:
        if self._fd is not None:
            try:
                os.close(self._fd)
            except OSError:
                pass
        self._fd, self._buf = None, b""
        if self._udp is not None:
            self._udp.close()
            self._udp = None

    # -- the bytes ----------------------------------------------------------
    def _drain(self) -> None:
        while self._fd is not None:
            try:
                chunk = os.read(self._fd, 8192)
            except BlockingIOError:
                break
            except OSError:
                self.close()  # unplugged
                return
            if not chunk:
                break
            self._buf += chunk
        if b"\n" in self._buf:
            *lines, self._buf = self._buf.split(b"\n")
            for line in lines:
                self._feed(line)
        elif len(self._buf) > 8192:
            self._buf = b""  # something is talking, but not in lines we know

    def _feed(self, line: bytes) -> None:
        start = line.find(b"{")
        if start < 0:
            return
        try:
            obj = json.loads(line[start:].decode("utf-8", "replace"))
        except ValueError:
            return
        if not isinstance(obj, dict) or not AIR_KEYS & obj.keys():
            return
        last = self._reading
        if (
            last is not None
            and obj.get("uptime_s") is not None
            and (obj.get("src"), obj.get("uptime_s")) == (last.get("src"), last.get("uptime_s"))
        ):
            return  # the same publish again, by the other route
        self._reading, self._at = obj, time.time()
        if self._db is not None:
            self._db.insert_air(obj, self._at)

    def _drain_udp(self) -> None:
        while self._udp is not None:
            try:
                data = self._udp.recv(2048)
            except BlockingIOError:
                break
            except OSError:
                break
            self._feed(data)

    # -- the reading --------------------------------------------------------
    def sample(self) -> Air | None:
        now = time.monotonic()
        if self._fd is None and (not self._probed or now - self._probed >= self.RETRY):
            self._probed = now
            self._open()
        if self._fd is not None:
            self._drain()
        self._drain_udp()

        if self._reading is None:
            # Port open but the board hasn't spoken yet: say so, rather than
            # leaving a gap where the pane is about to appear.
            return (
                Air(None, 0.0, None, None, None, None, None, None, None, pending=True)
                if self._fd is not None
                else None
            )
        age = max(0.0, time.time() - self._at)
        if self._fd is None and age > AIR_STALE_AFTER:
            return None  # board gone and the last reading has aged out
        r = self._reading
        src = r.get("src")
        return Air(
            src=src if isinstance(src, str) else None,
            age=age,
            co2=_air_num(r, "co2"),
            temp=_air_num(r, "temperature"),
            rh=_air_num(r, "relative_humidity"),
            pm2p5=_air_num(r, "mass_concentration_pm2p5"),
            pm10=_air_num(r, "mass_concentration_pm10p0"),
            voc=_air_num(r, "voc_index"),
            nox=_air_num(r, "nox_index"),
        )


# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------
def color_for_pct(pct: float) -> str:
    if pct >= 90:
        return C.RED
    if pct >= 60:
        return C.YELLOW
    return C.GREEN


def bar(
    pct: float | None,
    width: int,
    label_inside: str | None = None,
    color: str | None = None,
) -> str:
    """A filled bar. `color` overrides the default load-style colouring —
    CO2, say, is not "bad at 90%" but bad at its own thresholds."""
    if pct is None:
        body = "─" * width
        return "[" + C.wrap(body, C.GREY) + "]"
    pct = max(0.0, min(100.0, pct))
    filled = int(round(pct / 100 * width))
    text = (label_inside or "")
    if len(text) > width:  # don't let a long label spill past the bar
        text = text[:width]
    text = text.center(width)
    out = []
    col = color or color_for_pct(pct)
    for i, ch in enumerate(text):
        if i < filled:
            out.append(C.wrap(ch if ch != " " else "█", col))
        else:
            out.append(C.wrap(ch if ch != " " else "·", C.GREY))
    return "[" + "".join(out) + "]"


def fmt(v: float | None, unit: str = "", nd: int = 0) -> str:
    if v is None:
        return "n/a"
    if nd == 0:
        return f"{int(round(v))}{unit}"
    return f"{v:.{nd}f}{unit}"


def gib(mib: float | None) -> str:
    if mib is None:
        return "n/a"
    return f"{mib / 1024:.1f}GiB"


def wrap_stats(stats: list[tuple], width: int, indent: str = "  ") -> list[str]:
    """Pack `(label, value)` stat segments into lines that fit `width`.

    A third element, if present, colours the value — measured against the
    plain text, so the escape codes never count towards the width.

    On a wide terminal everything lands on one line (identical to before);
    on a skinny pane the segments flow onto as many lines as needed.
    """
    sep = "   "
    avail = max(1, width - len(indent))
    lines: list[str] = []
    cur: list[str] = []
    cur_len = 0
    for k, v, *rest in stats:
        plain_len = len(k) + 1 + len(v)  # "label value"
        seg = f"{C.wrap(k, C.GREY)} {C.wrap(v, *rest) if rest else v}"
        extra = plain_len + (len(sep) if cur else 0)
        if cur and cur_len + extra > avail:
            lines.append(indent + sep.join(cur))
            cur, cur_len = [], 0
            extra = plain_len
        cur.append(seg)
        cur_len += extra
    if cur:
        lines.append(indent + sep.join(cur))
    return lines


def proc_section(procs: list[Proc], width: int, narrow: bool) -> list[str]:
    """Render the 'GPU processes' table as a list of lines."""
    lines = [C.wrap("GPU processes", C.BOLD)]
    if not procs:
        lines.append(C.wrap("  (none)", C.GREY))
        return lines
    ordered = sorted(procs, key=lambda x: (x.mem or 0), reverse=True)
    if narrow:
        # Drop the fixed column padding; truncate names to what's left.
        lines.append(C.wrap("  PID  MEM  PROCESS", C.GREY))
        for p in ordered:
            memstr = gib(p.mem)
            used = 2 + len(str(p.pid)) + 1 + len(memstr) + 1
            lines.append(f"  {p.pid} {memstr} {p.name[: max(0, width - used)]}")
    else:
        lines.append(C.wrap(f"  {'PID':>8}  {'MEM':>9}  PROCESS", C.GREY))
        for p in ordered:
            lines.append(
                f"  {p.pid:>8}  {gib(p.mem):>9}  {p.name[: max(0, width - 25)]}"
            )
    return lines


# Indoor CO2, in the usual rule-of-thumb bands: ~400 ppm is outdoor air,
# 1000 is the common ventilation target, and past 1500 people report the
# headaches and fog that ventilation guidance is written to avoid.
def _co2_verdict(ppm: float | None) -> tuple[str, str]:
    if ppm is None:
        return "", C.GREY
    if ppm < 1000:
        return "fresh", C.GREEN
    if ppm < 1500:
        return "stuffy", C.YELLOW
    return "poor", C.RED


# PM2.5 against the EPA's AQI breakpoints for the good/moderate boundary
# (12 µg/m³) and the start of "unhealthy for sensitive groups" (35.4).
def _pm_color(ugm3: float | None) -> str:
    if ugm3 is None:
        return C.GREY
    if ugm3 <= 12:
        return C.GREEN
    if ugm3 <= 35.4:
        return C.YELLOW
    return C.RED


def _ago(seconds: float) -> str:
    if seconds < 60:
        return f"{int(seconds)}s ago"
    if seconds < 3600:
        return f"{int(seconds // 60)}m ago"
    return f"{seconds / 3600:.1f}h ago"


def air_section(air: Air, width: int, narrow: bool) -> list[str]:
    """Render the 'Air' pane — the USB air-quality sensor's latest reading."""
    if air.pending:
        return [
            C.wrap("Air", C.BOLD) + "  " + C.wrap("(sensor found)", C.GREY),
            C.wrap("  waiting for the first reading (up to 30s)", C.GREY),
        ]
    tag = ", ".join(x for x in (air.src, _ago(air.age)) if x)
    head = C.wrap("Air", C.BOLD) + "  " + C.wrap(f"({tag})", C.GREY)
    if air.stale:
        head += "  " + C.wrap("stale", C.YELLOW)
    lines = [head]

    word, col = _co2_verdict(air.co2)
    # 400 ppm is outdoor air and nothing indoors reads below it; 2000 is well
    # past the point where the only useful message is "open a window".
    pct = None if air.co2 is None else (air.co2 - 400) / 16.0
    bar_w = max(10, min(40, width - (12 if narrow else 36)))
    line = "  CO2     " + bar(pct, bar_w, fmt(air.co2, "ppm"), color=col)
    if not narrow and word:
        line += "  " + C.wrap(word, col)
    lines.append(line)

    stats = [
        ("temp", fmt(air.temp, "°C", 1)),
        ("RH", fmt(air.rh, "%", 0)),
        ("PM2.5", fmt(air.pm2p5, "µg/m³", 1), _pm_color(air.pm2p5)),
        ("PM10", fmt(air.pm10, "µg/m³", 1)),
        ("VOC", fmt(air.voc, "", 0)),
        ("NOx", fmt(air.nox, "", 0)),
    ]
    lines.extend(wrap_stats(stats, width))
    return lines


def _elide(text: str, width: int) -> str:
    """Shorten from the middle, where a model name says least: the family
    is at the front and the quantisation at the back."""
    if len(text) <= width:
        return text
    if width < 3:
        return text[: max(0, width)]
    head = width // 2
    return text[:head] + "…" + text[len(text) - (width - head - 1) :]


def _llm_state(m: Llm) -> tuple[str, str, str]:
    """(glyph colour, state word, word colour) for one model."""
    if m.state == "busy":
        word = "busy"
        if m.busy is not None:
            word += f" {m.busy}/{m.slots}" if m.slots else f" {m.busy}"
        return C.GREEN, word, C.GREEN
    if m.state == "loading":
        return C.YELLOW, "loading", C.YELLOW
    return C.GREEN, m.state, C.GREY  # up and waiting: idle / loaded / running


def llm_section(llms: list[Llm], width: int, narrow: bool) -> list[str]:
    """Render the 'LLMs' pane — local model servers and what they're doing."""
    models = sum(1 for m in llms if m.model)
    busy = sum(1 for m in llms if m.state == "busy")
    tally = f"{models} model" + ("" if models == 1 else "s")
    if busy:
        tally += f", {busy} busy"
    lines = [C.wrap("LLMs", C.BOLD) + "  " + C.wrap(f"({tally})", C.GREY)]
    states = {id(m): _llm_state(m) for m in llms}

    def glyph(m: Llm) -> str:
        return C.wrap("◐" if m.state == "loading" else "●", states[id(m)][0])

    def name(m: Llm, w: int) -> str:
        text = _elide(m.label, w)
        return text if m.model else C.wrap(text, C.GREY)

    if narrow:
        lines.append(C.wrap("  MODEL  STATE", C.GREY))
        for m in llms:
            _, word, col = states[id(m)]
            used = 4 + 1 + len(word)
            lines.append(f"  {glyph(m)} {name(m, max(0, width - used))} " + C.wrap(word, col))
        return lines

    owners = {}
    for m in llms:
        s = m.server
        if s.container:
            owners[id(m)] = (s.container, " ·docker")
        elif s.unit:
            owners[id(m)] = (s.unit.removesuffix(".service"), "")
        else:
            owners[id(m)] = (f"pid {s.pid}", "")
    ports = {id(m): str(m.server.addr[1]) if m.server.addr else "-" for m in llms}
    eng_w = max(6, max(len(m.server.engine) for m in llms))          # >= "ENGINE"
    state_w = max(5, max(len(states[id(m)][1]) for m in llms))       # >= "STATE"
    mem_w = max(3, max(len(gib(m.mem)) for m in llms))               # >= "MEM"
    port_w = max(4, max(len(p) for p in ports.values()))             # >= "PORT"
    # The model column gets what's left once the others, and up to 20
    # columns of owner, have their room.
    rest = 4 + 2 + eng_w + 2 + state_w + 2 + mem_w + 2 + port_w + 2
    owner_w = min(20, max(len(o) + len(t) for o, t in owners.values()))
    model_w = max(5, min(max(len(m.label) for m in llms), width - rest - owner_w))
    lines.append(
        C.wrap(
            f"    {'MODEL':<{model_w}}  {'ENGINE':<{eng_w}}  {'STATE':<{state_w}}  "
            f"{'MEM':>{mem_w}}  {'PORT':>{port_w}}  OWNER",
            C.GREY,
        )
    )
    for m in llms:
        _, word, col = states[id(m)]
        owner, tag = owners[id(m)]
        used = rest + model_w + len(tag)
        lines.append(
            f"  {glyph(m)} {name(m, model_w)}{' ' * (model_w - min(model_w, len(m.label)))}  "
            f"{m.server.engine:<{eng_w}}  "
            + C.wrap(f"{word:<{state_w}}", col)
            + f"  {gib(m.mem):>{mem_w}}  {ports[id(m)]:>{port_w}}  "
            + owner[: max(0, width - used)]
            + C.wrap(tag, C.GREY)
        )
    return lines


def _service_color(s: Service) -> str:
    if s.state == "failed":
        return C.RED
    if s.state in ("activating", "deactivating"):
        return C.YELLOW
    if s.state == "active":
        return C.GREEN if s.sub == "running" else C.GREY
    return C.GREY


def _service_glyph(s: Service) -> str:
    if s.state in ("activating", "deactivating"):
        return "◐"
    return "●" if s.state in ("failed", "active") and s.sub != "exited" else "○"


def service_section(services: list[Service], width: int, narrow: bool) -> list[str]:
    """Render the 'Services' table (your own systemd units) as a list of lines."""
    running = sum(1 for s in services if s.sub == "running")
    failed = sum(1 for s in services if s.state == "failed")
    tally = f"{running} up"
    if failed:
        tally += f", {failed} failed"
    lines = [C.wrap("Services", C.BOLD) + "  " + C.wrap(f"({tally})", C.GREY)]
    if not services:
        lines.append(C.wrap("  (none)", C.GREY))
        return lines
    name_w = max(4, min(28, max(len(s.short) for s in services)))   # >= "UNIT"
    stat_w = max(5, max(len(s.status) for s in services))           # >= "STATE"
    if narrow:
        lines.append(C.wrap("  UNIT  STATE", C.GREY))
        for s in services:
            col = _service_color(s)
            used = 4 + 1 + len(s.status)
            lines.append(
                f"  {C.wrap(_service_glyph(s), col)} "
                f"{s.short[: max(0, width - used)]} " + C.wrap(s.status, col)
            )
        return lines
    lines.append(
        C.wrap(f"    {'UNIT':<{name_w}}  {'SCOPE':<6}  {'STATE':<{stat_w}}  {'PID':>7}", C.GREY)
    )
    for s in services:
        col = _service_color(s)
        pid = s.pid if s.pid and s.pid != "0" else "-"
        lines.append(
            f"  {C.wrap(_service_glyph(s), col)} {s.short[:name_w]:<{name_w}}  "
            + C.wrap(f"{s.scope:<6}", C.GREY)
            + "  "
            + C.wrap(f"{s.status:<{stat_w}}", col)
            + "  "
            + C.wrap(f"{pid:>7}", C.GREY)
        )
    return lines


def port_section(listeners: list[Listener], width: int, narrow: bool) -> list[str]:
    """Render the 'Ports' table (listeners in the watched ranges) as lines."""
    public = sum(1 for l in listeners if l.public)
    tally = f"{len(listeners)} listening"
    if public:
        tally += f", {public} public"
    lines = [C.wrap("Ports", C.BOLD) + "  " + C.wrap(f"({tally})", C.GREY)]
    if not listeners:
        lines.append(C.wrap("  (nothing in the watched ranges)", C.GREY))
        return lines

    # tcp is the common case and goes unmarked; udp is called out.
    labels = {id(l): f"{l.port}/udp" if l.proto == "udp" else str(l.port) for l in listeners}
    port_w = max(4, max(len(v) for v in labels.values()))           # >= "PORT"
    bind_w = max(4, min(15, max(len(l.bind) for l in listeners)))   # >= "BIND"
    gap = " " if narrow else "  "
    lines.append(
        C.wrap(f"  {'PORT':>{port_w}}{gap}{'BIND':<{bind_w}}{gap}OWNER", C.GREY)
    )
    for l in listeners:
        port = f"{labels[id(l)]:>{port_w}}"
        bind = f"{l.bind[:bind_w]:<{bind_w}}"
        if l.container:
            tag = " ·docker"
        elif l.owner_kind == "unknown" and l.uid is not None:
            tag = " ·" + username(l.uid)  # at least say whose port it is
        else:
            tag = ""
        used = 2 + port_w + len(gap) + bind_w + len(gap) + len(tag)
        owner = (
            l.owner[: max(0, width - used)]
            if l.owner_kind != "unknown"
            else C.wrap("?", C.GREY)
        )
        lines.append(
            f"  {port}{gap}"
            + C.wrap(bind, C.YELLOW if l.public else C.GREY)
            + gap
            + owner
            + C.wrap(tag, C.GREY)
        )
    return lines


# A pane is only worth showing if it can fit its heading, its column header,
# one row of data, and the marker saying how much got cut.
MIN_PANE_ROWS = 4


def clip_pane(block: list[str], rows: int) -> list[str]:
    """Trim a rendered table to `rows` lines, noting how many were dropped."""
    if len(block) <= rows:
        return block
    keep = block[: max(1, rows - 1)]
    return keep + [C.wrap(f"  … +{len(block) - len(keep)} more", C.GREY)]


def render(
    gpus: list[Gpu],
    procs: list[Proc],
    width: int,
    height: int,
    interval: float,
    clear_eol: bool = False,
    services: list[Service] | None = None,
    listeners: list[Listener] | None = None,
    air: Air | None = None,
    llms: list[Llm] | None = None,
) -> str:
    lines: list[str] = []
    host = os.uname().nodename
    now = time.strftime("%H:%M:%S")
    driver = gpus[0].driver if gpus else "?"
    narrow = width < 56
    title = C.wrap(" sparktop ", C.BOLD, C.CYAN)
    if narrow:
        # Stack the metadata so nothing runs off a skinny pane.
        lines.append(f"{title} {C.wrap(host, C.BOLD)}")
        lines.append(C.wrap(f"driver {driver}  every {interval}s  {now}", C.GREY))
    else:
        head = (
            f"{title} {C.wrap(host, C.BOLD)}  "
            f"{C.wrap('driver ' + driver, C.GREY)}  "
            f"{C.wrap('every ' + str(interval) + 's', C.GREY)}"
        )
        lines.append(head + "  " + C.wrap(now, C.GREY))
    lines.append(C.wrap("─" * width, C.GREY))

    # Wide: full bars with an external % readout. Narrow: drop the external %
    # (it's already centered inside the bar) and give the bar the room instead.
    if narrow:
        bar_w = max(10, min(40, width - 12))  # "  Compute " (10) + "[]" (2)
    else:
        bar_w = max(20, min(40, width - 36))
    for g in gpus:
        lines.append(
            C.wrap(f"GPU {g.index}", C.BOLD, C.BLUE)
            + " "
            + C.wrap(g.name, C.BOLD)
            + "  "
            + C.wrap(f"P-state {g.pstate}", C.GREY)
        )
        # Utilization
        u = g.util_gpu
        util_line = "  Compute " + bar(u, bar_w, f"{fmt(u, '%')}")
        if not narrow:
            util_line += "  " + C.wrap(
                fmt(u, "%"), color_for_pct(u) if u is not None else C.GREY
            )
        lines.append(util_line)
        # Memory
        mem_pct = (
            (g.mem_used / g.mem_total * 100)
            if g.mem_used is not None and g.mem_total
            else None
        )
        mem_inside = (
            gib(g.mem_used) if narrow
            else f"{gib(g.mem_used)}/{gib(g.mem_total)}"
        )
        mem_line = "  Memory  " + bar(mem_pct, bar_w, mem_inside)
        if not narrow:
            mem_line += "  " + C.wrap(
                fmt(mem_pct, "%"), color_for_pct(mem_pct) if mem_pct is not None else C.GREY
            )
        if g.mem_unified:
            mem_line += C.wrap(" unified", C.GREY)
        lines.append(mem_line)
        # Stats line
        pwr = fmt(g.power_draw, "W", 1)
        if g.power_limit:
            pwr += "/" + fmt(g.power_limit, "W", 0)
        stats = [
            ("temp", fmt(g.temp, "°C")),
            ("power", pwr),
            ("SM clk", fmt(g.clock_sm, "MHz")),
        ]
        lines.extend(wrap_stats(stats, width))
        lines.append("")

    # Everything below the GPU bars is secondary, in priority order. On a
    # short pane — e.g. a wide strip pinned to the top of a tmux layout — drop
    # whole tables from the bottom up so the GPU bars never scroll off the top.
    # The +2 reserves the blank + footer below; the strict `<` leaves one row
    # for the trailing newline in the live loop's write. `height <= 0` means
    # unbounded (one-shot snapshots show everything).
    blocks: list[list[str]] = []
    if air is not None:
        # First of the secondary panes: it's the shortest of them, and a
        # room you have to leave outranks a service you can restart.
        blocks.append(air_section(air, width, narrow))
    if llms:
        # Only when something is serving: a row per model is short, and
        # what's on the GPU is the next thing you'd ask a GPU monitor.
        blocks.append(llm_section(llms, width, narrow))
    if services is not None:
        blocks.append(service_section(services, width, narrow))
    if listeners is not None:
        blocks.append(port_section(listeners, width, narrow))
    blocks.append(proc_section(procs, width, narrow))

    # Rows left for the panes. `lines` already ends in a blank row, which
    # separates the first one; the 2 reserves the blank + footer below, and
    # the extra 1 leaves a row for the live loop's trailing newline.
    avail = max(0, height - len(lines) - 3) if height > 0 else -1  # -1 = unbounded
    if avail >= 0:
        # Drop whole panes from the bottom (lowest priority) until the rest
        # can each show something, then share out what's left top-down.
        n = len(blocks)
        while n and n * MIN_PANE_ROWS + (n - 1) > avail:
            n -= 1
        blocks = blocks[:n]

    body: list[str] = []
    for i, block in enumerate(blocks):
        if avail < 0:
            body += ([""] if body else []) + block
            continue
        sep = 1 if body else 0
        reserve = (len(blocks) - i - 1) * (MIN_PANE_ROWS + 1)
        body += [""] * sep + clip_pane(block, avail - len(body) - sep - reserve)
    if body:
        lines += body
    elif lines and lines[-1] == "":
        lines.pop()  # avoid a double blank before the footer when all hidden

    lines.append("")
    lines.append(C.wrap("q / Ctrl-C to quit", C.GREY))
    eol = CLEAR_LINE if clear_eol else ""
    return "\n".join(line + eol for line in lines)


# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------
class Extras:
    """Samples the secondary panes, throttling the slow sources.

    `ss` is cheap enough to run every frame, but the unit list, the docker
    container list and the set of model servers barely move at 1 Hz, so
    they're re-read on a TTL instead. Asking those servers whether they're
    busy is a request to localhost each, and is done every frame.
    The air sensor needs no throttling of its own: draining a serial buffer
    that is nearly always empty costs one non-blocking read.
    """

    TTL = 5.0

    def __init__(
        self,
        want_services: bool,
        port_ranges: list[tuple[int, int]] | None,
        want_llms: bool = False,
        air: AirReader | None = None,
        db: Db | None = None,
    ):
        self.want_services = want_services
        self.port_ranges = port_ranges
        self.want_llms = want_llms
        self.air = air
        self.db = db
        self.services: list[Service] | None = None
        self.docker = Docker()
        self.llm_servers: list[LlmServer] | None = None
        self._stamp = 0.0

    def close(self) -> None:
        if self.air is not None:
            self.air.close()
        if self.db is not None:
            self.db.close()

    def sample(
        self, procs: list[Proc]
    ) -> tuple[list[Service] | None, list[Listener] | None, Air | None, list[Llm] | None]:
        now = time.monotonic()
        if not self._stamp or now - self._stamp >= self.TTL:
            self._stamp = now
            if self.want_services:
                self.services = read_services()
            if self.port_ranges is not None or self.want_llms:
                self.docker = read_docker()
            if self.want_llms:
                self.llm_servers = find_llm_servers(self.docker)
        listeners = (
            read_listeners(self.port_ranges, self.docker.ports, self.docker.names)
            if self.port_ranges is not None
            else None
        )
        llms = read_llms(self.llm_servers, procs) if self.llm_servers else None
        return self.services, listeners, (self.air.sample() if self.air else None), llms


def run_once(interval: float, extras: Extras) -> int:
    gpus = read_gpus()
    procs = read_procs()
    services, listeners, air, llms = extras.sample(procs)
    width = shutil.get_terminal_size((100, 24)).columns
    # height 0 = show everything
    print(
        render(
            gpus, procs, width, 0, interval,
            services=services, listeners=listeners, air=air, llms=llms,
        )
    )
    return 0


def snapshot(extras: Extras) -> dict:
    """Everything the dashboard shows, as plain data (what --serve answers)."""
    out: dict = {"host": socket.gethostname(), "at": int(time.time())}
    procs: list[Proc] = []
    try:
        gpus = read_gpus()
        procs = read_procs()
        out["gpus"] = [
            {
                "name": g.name, "util": g.util_gpu, "util_mem": g.util_mem,
                "mem_used": g.mem_used, "mem_total": g.mem_total, "temp": g.temp,
                "power": g.power_draw, "power_limit": g.power_limit,
                "clock": g.clock_sm, "pstate": g.pstate,
            }
            for g in gpus
        ]
        out["procs"] = [
            {"pid": pr.pid, "name": pr.name, "mem": pr.mem}
            for pr in sorted(procs, key=lambda pr: -(pr.mem or 0))[:8]
        ]
    except SmiError as e:
        out["gpus"], out["procs"], out["error"] = [], [], str(e)
    services, listeners, air, llms = extras.sample(procs)
    if llms is not None:
        out["llms"] = [
            {
                "model": m.label, "engine": m.server.engine, "state": m.state,
                "busy": m.busy, "slots": m.slots, "mem": m.mem,
            }
            for m in llms
        ]
    if services is not None:
        out["services"] = [
            {"name": sv.short, "scope": sv.scope, "state": sv.state, "status": sv.status}
            for sv in services
        ]
    if listeners is not None:
        out["ports"] = [
            {"port": ln.port, "proto": ln.proto, "owner": ln.owner, "public": ln.public}
            for ln in listeners
        ]
    if air is not None and not air.pending:
        out["air"] = {
            "age": round(air.age), "stale": air.stale, "co2": air.co2, "temp": air.temp,
            "rh": air.rh, "pm2p5": air.pm2p5, "pm10": air.pm10, "voc": air.voc, "nox": air.nox,
        }
    return out


def air_history(extras: Extras, hours: float, points: int) -> dict:
    """The air sensor's last `hours`, averaged into `points` spans (GET /air)."""
    hours = min(max(hours, 0.1), 24 * 14)
    points = min(max(points, 1), 1440)
    now = time.time()
    air = extras.air.sample() if extras.air else None
    out: dict = {"at": int(now), "hours": hours, "step": round(hours * 3600 / points, 1)}
    if air is not None and not air.pending:
        out["now"] = {
            "age": round(air.age), "stale": air.stale, "co2": air.co2, "temp": air.temp,
            "rh": air.rh, "pm2p5": air.pm2p5, "pm10": air.pm10, "voc": air.voc, "nox": air.nox,
        }
    if extras.db is not None:
        out.update(extras.db.air_history(now - hours * 3600, now, points))
    return out


def run_serve(spec: str, extras: Extras) -> int:
    """Answer GET / with the snapshot as JSON, for a client that isn't a terminal.

    GET /air?hours=12&points=64 is the air sensor's history from the database.
    Read-only. The snapshot is sampled only when someone asks, and kept for a
    second so a few clients polling together cost one nvidia-smi; the air
    sensor is the exception, read every few seconds whoever is asking, since
    it is the one thing here being recorded and the kernel keeps only a few
    minutes of what the board said.
    One request at a time, on this thread: the database connection and the
    serial port belong to it.
    """
    import http.server
    import urllib.parse

    host, _, port = spec.rpartition(":")
    cache: dict = {"at": 0.0, "body": b""}

    class Handler(http.server.BaseHTTPRequestHandler):
        timeout = 5  # a client that stalls doesn't hold the others up for long

        def do_GET(self) -> None:
            url = urllib.parse.urlsplit(self.path)
            if url.path == "/air":
                q = urllib.parse.parse_qs(url.query)
                try:
                    hours = float(q.get("hours", ["12"])[0])
                    points = int(q.get("points", ["72"])[0])
                except ValueError:
                    self.send_error(400)
                    return
                if hours != hours:  # nan
                    self.send_error(400)
                    return
                body = json.dumps(air_history(extras, hours, points), separators=(",", ":")).encode()
            elif url.path in ("/", "/snapshot"):
                if time.monotonic() - cache["at"] >= 1.0:
                    cache["body"] = json.dumps(snapshot(extras), separators=(",", ":")).encode()
                    cache["at"] = time.monotonic()
                body = cache["body"]
            else:
                self.send_error(404)
                return
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *a) -> None:
            pass

    class Server(http.server.HTTPServer):
        AIR_EVERY = 5.0
        _air_at = 0.0

        def service_actions(self) -> None:  # between requests, about twice a second
            now = time.monotonic()
            if extras.air is not None and now - self._air_at >= self.AIR_EVERY:
                self._air_at = now
                extras.air.sample()

    try:
        srv = Server((host or "127.0.0.1", int(port)), Handler)
    except (OSError, ValueError) as e:
        print(f"sparktop: can't serve on {spec}: {e}", file=sys.stderr)
        return 1
    print(f"sparktop: serving on http://{host or '127.0.0.1'}:{port}/", file=sys.stderr)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()
        extras.close()
    return 0


def _wait_for_quit(timeout: float) -> bool:
    """Sleep up to `timeout` seconds, returning True if the user pressed q.

    Falls back to a plain sleep when stdin isn't an interactive terminal.
    """
    import select

    if not sys.stdin.isatty():
        time.sleep(timeout)
        return False
    r, _, _ = select.select([sys.stdin], [], [], timeout)
    if r:
        ch = sys.stdin.read(1)
        return ch in ("q", "Q", "\x03")  # q or Ctrl-C
    return False


def run_live(interval: float, extras: Extras) -> int:
    import contextlib

    termios = tty = old_term = None
    if sys.stdin.isatty():
        try:
            import termios as _termios
            import tty as _tty

            termios, tty = _termios, _tty
            old_term = termios.tcgetattr(sys.stdin)
            tty.setcbreak(sys.stdin.fileno())  # read keys without Enter
        except Exception:
            termios = None

    def restore(*_):
        if termios and old_term is not None:
            with contextlib.suppress(Exception):
                termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_term)
        sys.stdout.write(ALT_SCREEN_OFF)
        sys.stdout.flush()

    # Restore the terminal even if we're killed (e.g. SIGTERM from `timeout`).
    prev_term = signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(SystemExit))

    sys.stdout.write(ALT_SCREEN_ON)
    sys.stdout.flush()
    try:
        while True:
            try:
                gpus = read_gpus()
                procs = read_procs()
                services, listeners, air, llms = extras.sample(procs)
                size = shutil.get_terminal_size((100, 24))
                frame = render(
                    gpus,
                    procs,
                    size.columns,
                    size.lines,
                    interval,
                    clear_eol=True,
                    services=services,
                    listeners=listeners,
                    air=air,
                    llms=llms,
                )
            except SmiError as e:
                frame = C.wrap("sparktop error\n\n", C.BOLD, C.RED) + str(e)
            sys.stdout.write(HOME + frame + "\n" + "\033[J")
            sys.stdout.flush()
            if _wait_for_quit(interval):
                break
    except (KeyboardInterrupt, BrokenPipeError, SystemExit):
        pass
    finally:
        restore()
        extras.close()
        with contextlib.suppress(Exception):
            signal.signal(signal.SIGTERM, prev_term)
    return 0


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="sparktop",
        description="Live GPU monitor for the NVIDIA DGX Spark.",
    )
    p.add_argument(
        "-n",
        "--interval",
        type=float,
        default=1.0,
        metavar="SECONDS",
        help="refresh interval (default: 1.0)",
    )
    p.add_argument(
        "--once",
        action="store_true",
        help="print a single snapshot and exit",
    )
    p.add_argument(
        "--serve",
        metavar="[HOST:]PORT",
        help=(
            "serve the snapshot as JSON over HTTP instead of drawing it "
            "(GET /; HOST defaults to 127.0.0.1)"
        ),
    )
    p.add_argument(
        "--no-color",
        action="store_true",
        help="disable ANSI color",
    )
    p.add_argument(
        "--ports",
        default=DEFAULT_PORT_SPEC,
        metavar="SPEC",
        help=(
            "comma-separated ports/ranges to watch, e.g. '3000-3009,8080,25565' "
            "(default: common dev ports; override with $SPARKTOP_PORTS)"
        ),
    )
    p.add_argument(
        "--no-ports",
        action="store_true",
        help="hide the listening-ports pane",
    )
    p.add_argument(
        "--no-services",
        action="store_true",
        help="hide the systemd services pane",
    )
    p.add_argument(
        "--air-udp",
        type=int,
        default=int(os.environ.get("SPARKTOP_AIR_UDP", AIR_UDP_PORT)),
        metavar="PORT",
        help=(
            "also hear the sensor's WiFi broadcast on this UDP port, for a board "
            f"that isn't plugged in here (default: {AIR_UDP_PORT}; 0 = USB only; "
            "$SPARKTOP_AIR_UDP)"
        ),
    )
    p.add_argument(
        "--air-device",
        default=os.environ.get("SPARKTOP_AIR_DEVICE"),
        metavar="PATH",
        help=(
            "serial port of the air-quality sensor (default: auto-detect a "
            "Feather/ESP32 under /dev/serial/by-id; $SPARKTOP_AIR_DEVICE)"
        ),
    )
    p.add_argument(
        "--no-air",
        action="store_true",
        help="hide the air-quality pane",
    )
    p.add_argument(
        "--no-llms",
        action="store_true",
        help="hide the local-LLMs pane",
    )
    p.add_argument(
        "--db",
        default=default_db_path(),
        metavar="PATH",
        help=(
            "sqlite database that air readings are recorded in "
            "(default: $SPARKTOP_DB, else ~/.local/share/sparktop/sparktop.db)"
        ),
    )
    p.add_argument(
        "--no-db",
        action="store_true",
        help="don't record anything (readings then won't survive a restart)",
    )
    args = p.parse_args(argv)

    if args.no_color or not sys.stdout.isatty():
        C.enabled = False
    if args.interval <= 0:
        p.error("--interval must be positive")

    ranges = None
    if not args.no_ports:
        try:
            ranges = parse_port_spec(args.ports)
        except ValueError as e:
            p.error(str(e))
    db = None
    if not args.no_db:
        db = Db(args.db)
        err = db.open()
        if err:
            # Before the alt screen goes up, so it's actually seen.
            print(f"sparktop: database unavailable, not recording: {err}", file=sys.stderr)
            db = None
    extras = Extras(
        want_services=not args.no_services,
        port_ranges=ranges,
        want_llms=not args.no_llms,
        air=None if args.no_air else AirReader(args.air_device, db, args.air_udp),
        db=db,
    )

    signal.signal(signal.SIGINT, signal.default_int_handler)

    if args.serve:
        return run_serve(args.serve, extras)
    if args.once:
        try:
            return run_once(args.interval, extras)
        except SmiError as e:
            print(f"sparktop: {e}", file=sys.stderr)
            return 1
        finally:
            extras.close()
    return run_live(args.interval, extras)


if __name__ == "__main__":
    sys.exit(main())
