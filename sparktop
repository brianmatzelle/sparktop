#!/usr/bin/env python3
"""sparktop — a live, top-style GPU monitor for the NVIDIA DGX Spark.

Pure stdlib. Reads telemetry from `nvidia-smi` (NVML), which is the only
interface that exposes GPU utilization/power/clocks on the GB10 superchip.

Usage:
    sparktop                 # live view, refresh every 1s
    sparktop -n 2            # refresh every 2 seconds
    sparktop --once          # print one snapshot and exit (good for scripts)
    sparktop --no-color      # disable ANSI color
    sparktop --ports 3000-3009,8080   # which ports to watch
    sparktop --no-services   # hide the systemd services pane
    sparktop --no-ports      # hide the listening-ports pane

Override the nvidia-smi binary (handy for testing) with:
    SPARKTOP_NVIDIA_SMI=/path/to/fake-nvidia-smi sparktop
"""
from __future__ import annotations

import argparse
import os
import pwd
import re
import shutil
import signal
import subprocess
import sys
import time
from dataclasses import dataclass

NVIDIA_SMI = os.environ.get("SPARKTOP_NVIDIA_SMI", "nvidia-smi")

# Per-GPU fields, in query order. Keep names valid for `--query-gpu`.
GPU_FIELDS = [
    "index",
    "name",
    "driver_version",
    "temperature.gpu",
    "utilization.gpu",
    "utilization.memory",
    "memory.total",
    "memory.used",
    "memory.free",
    "power.draw",
    "power.limit",
    "clocks.sm",
    "pstate",
]

PROC_FIELDS = ["pid", "process_name", "used_memory"]


# ---------------------------------------------------------------------------
# ANSI helpers
# ---------------------------------------------------------------------------
class C:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    CYAN = "\033[36m"
    GREY = "\033[90m"

    enabled = True

    @classmethod
    def wrap(cls, text: str, *codes: str) -> str:
        if not cls.enabled or not codes:
            return text
        return "".join(codes) + text + cls.RESET


ALT_SCREEN_ON = "\033[?1049h\033[?25l"   # enter alt buffer, hide cursor
ALT_SCREEN_OFF = "\033[?25h\033[?1049l"  # show cursor, leave alt buffer
HOME = "\033[H"
CLEAR = "\033[2J"
CLEAR_LINE = "\033[K"


# ---------------------------------------------------------------------------
# Data model
# ---------------------------------------------------------------------------
@dataclass
class Gpu:
    index: str
    name: str
    driver: str
    temp: float | None
    util_gpu: float | None
    util_mem: float | None
    mem_total: float | None  # MiB
    mem_used: float | None
    mem_free: float | None
    power_draw: float | None  # W
    power_limit: float | None
    clock_sm: float | None    # MHz
    pstate: str
    mem_unified: bool = False  # memory came from the shared system pool


@dataclass
class Proc:
    pid: str
    name: str
    mem: float | None  # MiB


@dataclass
class Service:
    """A systemd unit we consider 'yours' (see read_services)."""
    unit: str          # "garvis-bot.service"
    scope: str         # "system" | "user"
    state: str         # ActiveState, e.g. "active" / "failed"
    sub: str           # SubState, e.g. "running" / "exited"
    pid: str           # MainPID, "0" when there's no main process

    @property
    def short(self) -> str:
        return self.unit[: -len(".service")] if self.unit.endswith(".service") else self.unit

    @property
    def status(self) -> str:
        """The word we actually print: SubState is the informative half."""
        return self.sub or self.state


@dataclass
class Listener:
    """A socket bound to one of the watched dev ports."""
    port: int
    proto: str              # "tcp" | "udp"
    binds: set[str]         # raw local addresses seen for this port
    pid: str | None = None
    proc: str | None = None  # process name from ss (truncated to 15 chars)
    unit: str | None = None  # owning systemd unit, resolved via /proc/<pid>/cgroup
    container: str | None = None  # owning docker container, via `docker ps`
    uid: int | None = None  # socket owner, from /proc/net — set even when the
    #                         process itself is unidentifiable

    @property
    def owner(self) -> str:
        if self.unit:
            return self.unit[: -len(".service")] if self.unit.endswith(".service") else self.unit
        if self.container:
            return self.container
        return self.proc or "?"

    @property
    def owner_kind(self) -> str:
        if self.unit:
            return "unit"
        if self.container:
            return "docker"
        return "proc" if self.proc else "unknown"

    @property
    def bind(self) -> str:
        """One label for however many addresses this port is bound to.

        A wildcard bind subsumes the rest; otherwise a routable address is the
        interesting one, since that's what makes the port reachable off-box.
        """
        if any(b in ("0.0.0.0", "*", "::") for b in self.binds):
            return "*"
        routable = sorted(b for b in self.binds if not _loopback(b))
        return routable[0] if routable else "local"

    @property
    def public(self) -> bool:
        return self.bind != "local"


class SmiError(Exception):
    pass


# ---------------------------------------------------------------------------
# nvidia-smi access
# ---------------------------------------------------------------------------
def _num(token: str) -> float | None:
    token = token.strip()
    if not token or token in ("[N/A]", "N/A", "[Not Supported]", "Not Supported"):
        return None
    try:
        return float(token)
    except ValueError:
        return None


def _run_query(query_flag: str, fields: list[str]) -> list[list[str]]:
    cmd = [
        NVIDIA_SMI,
        f"--{query_flag}={','.join(fields)}",
        "--format=csv,noheader,nounits",
    ]
    try:
        out = subprocess.run(
            cmd, capture_output=True, text=True, timeout=10
        )
    except FileNotFoundError:
        raise SmiError(
            f"'{NVIDIA_SMI}' not found. Install the NVIDIA driver or set "
            "SPARKTOP_NVIDIA_SMI to its path."
        )
    except subprocess.TimeoutExpired:
        raise SmiError("nvidia-smi timed out.")
    if out.returncode != 0:
        msg = (out.stderr or out.stdout).strip()
        hint = ""
        if "version mismatch" in msg.lower():
            hint = (
                "\n\nThe NVIDIA kernel module and userspace library versions "
                "don't match.\nThis usually happens after a driver update "
                "before a reboot.\nFix it with:  sudo reboot"
            )
        raise SmiError(f"nvidia-smi failed:\n{msg}{hint}")
    return [
        [c.strip() for c in line.split(",")]
        for line in out.stdout.splitlines()
        if line.strip()
    ]


def read_gpus() -> list[Gpu]:
    rows = _run_query("query-gpu", GPU_FIELDS)
    gpus = []
    for r in rows:
        if len(r) < len(GPU_FIELDS):
            continue
        gpus.append(
            Gpu(
                index=r[0],
                name=r[1],
                driver=r[2],
                temp=_num(r[3]),
                util_gpu=_num(r[4]),
                util_mem=_num(r[5]),
                mem_total=_num(r[6]),
                mem_used=_num(r[7]),
                mem_free=_num(r[8]),
                power_draw=_num(r[9]),
                power_limit=_num(r[10]),
                clock_sm=_num(r[11]),
                pstate=r[12],
            )
        )
    # Unified-memory fallback: when nvidia-smi exposes no VRAM (GB10/Grace
    # systems like the DGX Spark), fill memory from the shared system pool.
    if any(g.mem_total is None for g in gpus):
        sys_total, sys_used = read_meminfo()
        if sys_total is not None:
            for g in gpus:
                if g.mem_total is None:
                    g.mem_total = sys_total
                    g.mem_used = sys_used
                    g.mem_free = sys_total - (sys_used or 0)
                    g.mem_unified = True
    return gpus


def read_meminfo() -> tuple[float | None, float | None]:
    """Return (total_mib, used_mib) from /proc/meminfo, or (None, None).

    On unified-memory platforms like the DGX Spark, the GPU has no dedicated
    VRAM, so nvidia-smi reports [N/A] for every memory field; the GPU instead
    allocates from the shared system pool. We approximate "used" the same way
    `free` does: MemTotal - MemAvailable.
    """
    vals: dict[str, float] = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                key, _, rest = line.partition(":")
                if key in ("MemTotal", "MemAvailable"):
                    vals[key] = float(rest.split()[0]) / 1024  # kB -> MiB
                    if len(vals) == 2:
                        break
    except (OSError, ValueError, IndexError):
        return None, None
    total, avail = vals.get("MemTotal"), vals.get("MemAvailable")
    if total is None or avail is None:
        return None, None
    return total, total - avail


def read_procs() -> list[Proc]:
    try:
        rows = _run_query("query-compute-apps", PROC_FIELDS)
    except SmiError:
        return []
    procs = []
    for r in rows:
        if len(r) < 3:
            continue
        procs.append(Proc(pid=r[0], name=r[1], mem=_num(r[2])))
    return procs


# ---------------------------------------------------------------------------
# systemd services
# ---------------------------------------------------------------------------
def _run(cmd: list[str], timeout: float = 5.0) -> str | None:
    """Run a command, returning stdout, or None if it isn't usable.

    Unlike nvidia-smi, none of these sources are essential — a box without
    systemd, ss or docker just shows fewer panes.
    """
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return None
    if out.returncode != 0:
        return None
    return out.stdout


# Unit files shipped by the distro live here; anything else is hand-written.
VENDOR_UNIT_DIRS = ("/usr/lib/systemd/", "/lib/systemd/", "/run/systemd/", "/usr/local/lib/systemd/")

SERVICE_PROPS = ["Id", "FragmentPath", "MainPID", "ActiveState", "SubState"]


def _parse_show(text: str) -> list[dict[str, str]]:
    """Split `systemctl show` output into one dict per blank-line-separated record."""
    records, cur = [], {}
    for line in text.splitlines():
        if not line.strip():
            if cur:
                records.append(cur)
                cur = {}
            continue
        key, _, val = line.partition("=")
        cur[key] = val
    if cur:
        records.append(cur)
    return records


def _read_services_scope(scope: str) -> list[Service] | None:
    cmd = ["systemctl"]
    if scope == "user":
        cmd.append("--user")
    cmd += ["show", "*.service", f"--property={','.join(SERVICE_PROPS)}", "--no-pager"]
    text = _run(cmd)
    if text is None:
        return None  # no systemd, or no user bus on this login
    services = []
    for rec in _parse_show(text):
        unit, path = rec.get("Id", ""), rec.get("FragmentPath", "")
        # "Yours" = a unit file you wrote. Vendor units live under /usr/lib or
        # /lib; snap generates its own into /etc/systemd/system, so drop those
        # by name. Units with no fragment at all are aliases/generated.
        if not unit or not path or unit.startswith("snap."):
            continue
        if path.startswith(VENDOR_UNIT_DIRS):
            continue
        services.append(
            Service(
                unit=unit,
                scope=scope,
                state=rec.get("ActiveState", ""),
                sub=rec.get("SubState", ""),
                pid=rec.get("MainPID", "0"),
            )
        )
    return services


# Sort key: problems first, then things that are up, then the quiet ones.
STATE_RANK = {"failed": 0, "activating": 1, "deactivating": 1, "active": 2}


def read_services() -> list[Service] | None:
    scopes = [_read_services_scope("system"), _read_services_scope("user")]
    if all(s is None for s in scopes):
        return None
    services = [s for scope in scopes if scope for s in scope]
    services.sort(
        key=lambda s: (
            STATE_RANK.get(s.state, 3),
            s.sub != "running",
            s.scope != "user",
            s.short,
        )
    )
    return services


# ---------------------------------------------------------------------------
# Listening ports
# ---------------------------------------------------------------------------
DEFAULT_PORT_SPEC = os.environ.get(
    "SPARKTOP_PORTS",
    "3000-3009,4000-4009,4321-4322,5000-5009,5173-5183,5432,6379,7860,"
    "8000-8199,8888,9090,11434,19132,25565,25575,27017",
)


def parse_port_spec(spec: str) -> list[tuple[int, int]]:
    """Turn "3000-3009,8080,25565" into [(3000, 3009), (8080, 8080), ...]."""
    ranges: list[tuple[int, int]] = []
    for chunk in spec.split(","):
        chunk = chunk.strip()
        if not chunk:
            continue
        lo_s, _, hi_s = chunk.partition("-")
        try:
            lo = int(lo_s)
            hi = int(hi_s) if hi_s else lo
        except ValueError:
            raise ValueError(f"bad port spec: {chunk!r}")
        if not (0 < lo <= hi <= 65535):
            raise ValueError(f"bad port range: {chunk!r}")
        ranges.append((lo, hi))
    return ranges


def _in_ranges(port: int, ranges: list[tuple[int, int]]) -> bool:
    return any(lo <= port <= hi for lo, hi in ranges)


def _loopback(host: str) -> bool:
    return host.startswith("127.") or host in ("::1", "localhost")


def _split_hostport(addr: str) -> tuple[str, int] | None:
    """Split an ss local address ("127.0.0.1:8080", "[::]:22", "*:9090")."""
    host, sep, port_s = addr.rpartition(":")
    if not sep:
        return None
    try:
        port = int(port_s)
    except ValueError:
        return None
    host = host.partition("%")[0]  # drop the "%lo" scope suffix
    if host.startswith("[") and host.endswith("]"):
        host = host[1:-1]
    return host, port


def _pid_from_users(field: str) -> tuple[str, str] | None:
    """Pull (pid, name) out of ss's `users:(("nginx",pid=42,fd=6))` column."""
    m = re.search(r'\(\("([^"]*)",pid=(\d+)', field)
    return (m.group(2), m.group(1)) if m else None


# A container's processes live in /system.slice/docker-<full id>.scope.
DOCKER_SCOPE = re.compile(r"docker-([0-9a-f]{12,64})\.scope")


def cgroup_owner(pid: str) -> tuple[str | None, str | None]:
    """Map a PID to its (systemd unit, docker container id) via its cgroup.

    /proc/<pid>/cgroup is world-readable, so this works for other users'
    processes too — unlike ss, which only names PIDs you own.
    """
    try:
        with open(f"/proc/{pid}/cgroup") as f:
            data = f.read()
    except OSError:
        return None, None
    m = DOCKER_SCOPE.search(data)
    if m:
        return None, m.group(1)
    for part in reversed(data.replace("\n", "/").split("/")):
        if part.endswith(".service") and not part.startswith(("user@", "init")):
            return part, None
    return None, None


# The listening state in /proc/net: TCP_LISTEN for tcp, TCP_CLOSE for udp.
PROC_NET_LISTEN = {"tcp": "0A", "tcp6": "0A", "udp": "07", "udp6": "07"}


def read_socket_uids() -> dict[tuple[str, int], int]:
    """Map (proto, port) to the uid that owns the socket, from /proc/net.

    ss only names PIDs you own, but /proc/net always exposes each socket's
    uid. That's enough to say *whose* a port is even when the process behind
    it can't be identified — a root-owned port says so instead of just "?".
    """
    uids: dict[tuple[str, int], int] = {}
    for fname, listening in PROC_NET_LISTEN.items():
        try:
            with open(f"/proc/net/{fname}") as f:
                next(f, None)  # column header
                for line in f:
                    parts = line.split()
                    if len(parts) < 8 or parts[3] != listening:
                        continue
                    try:
                        port = int(parts[1].rpartition(":")[2], 16)
                        uid = int(parts[7])
                    except ValueError:
                        continue
                    # v4 and v6 share a port; either owner answers the question.
                    uids.setdefault((fname.rstrip("6"), port), uid)
        except OSError:
            continue
    return uids


def username(uid: int) -> str:
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return f"uid{uid}"


def read_docker() -> tuple[dict[int, str], dict[str, str]]:
    """Ask docker for (published host port -> name, container id -> name).

    Both are needed because containers reach the host's ports two ways:
    a published port is proxied by a root-owned docker-proxy, so only the port
    number identifies it; a `network_mode: host` container instead listens on
    the host directly, so its own PID's cgroup names it — if ss can see it.
    """
    text = _run(
        ["docker", "ps", "--no-trunc", "--format", "{{.ID}}\t{{.Names}}\t{{.Ports}}"],
        timeout=3.0,
    )
    if not text:
        return {}, {}
    ports: dict[int, str] = {}
    names: dict[str, str] = {}
    for line in text.splitlines():
        cid, _, rest = line.partition("\t")
        name, _, portspec = rest.partition("\t")
        if not name:
            continue
        names[cid] = name
        # Published ports look like "0.0.0.0:25567->8080/tcp"; bare "5001/tcp"
        # is merely exposed and isn't listening on the host.
        for m in re.finditer(r"(?:\[[^\]]+\]|[\d.]+):(\d+)->", portspec):
            ports.setdefault(int(m.group(1)), name)
    return ports, names


def read_listeners(
    ranges: list[tuple[int, int]],
    docker_ports: dict[int, str],
    docker_names: dict[str, str],
) -> list[Listener] | None:
    # -tu gives a leading netid column, so the layout is the same either way.
    text = _run(["ss", "-H", "-tulnp"], timeout=5.0)
    if text is None:
        return None  # no iproute2
    found: dict[tuple[str, int], Listener] = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 5:
            continue
        proto, state, local = parts[0], parts[1], parts[4]
        if state not in ("LISTEN", "UNCONN"):
            continue
        hp = _split_hostport(local)
        if hp is None:
            continue
        host, port = hp
        if not _in_ranges(port, ranges):
            continue
        key = (proto, port)
        lis = found.get(key)
        if lis is None:
            lis = found[key] = Listener(port=port, proto=proto, binds=set())
        lis.binds.add(host)
        if lis.pid is None and len(parts) > 6:
            got = _pid_from_users(parts[6])
            if got:
                lis.pid, lis.proc = got
                lis.unit, cid = cgroup_owner(lis.pid)
                if cid:
                    lis.container = docker_names.get(cid) or docker_names.get(cid[:12])
    uids = read_socket_uids()
    for (proto, port), lis in found.items():
        # Only fall back to the published-port map when we learned nothing
        # useful: either ss named nobody (docker-proxy is root-owned, the usual
        # case) or it named docker.service, which is true but says nothing.
        if lis.container is None and port in docker_ports and (
            lis.unit == "docker.service" or (lis.unit is None and lis.proc is None)
        ):
            lis.unit = None
            lis.container = docker_ports[port]
        lis.uid = uids.get((proto, port))
    return sorted(found.values(), key=lambda l: (l.port, l.proto))


# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------
def color_for_pct(pct: float) -> str:
    if pct >= 90:
        return C.RED
    if pct >= 60:
        return C.YELLOW
    return C.GREEN


def bar(pct: float | None, width: int, label_inside: str | None = None) -> str:
    if pct is None:
        body = "─" * width
        return "[" + C.wrap(body, C.GREY) + "]"
    pct = max(0.0, min(100.0, pct))
    filled = int(round(pct / 100 * width))
    text = (label_inside or "")
    if len(text) > width:  # don't let a long label spill past the bar
        text = text[:width]
    text = text.center(width)
    out = []
    col = color_for_pct(pct)
    for i, ch in enumerate(text):
        if i < filled:
            out.append(C.wrap(ch if ch != " " else "█", col))
        else:
            out.append(C.wrap(ch if ch != " " else "·", C.GREY))
    return "[" + "".join(out) + "]"


def fmt(v: float | None, unit: str = "", nd: int = 0) -> str:
    if v is None:
        return "n/a"
    if nd == 0:
        return f"{int(round(v))}{unit}"
    return f"{v:.{nd}f}{unit}"


def gib(mib: float | None) -> str:
    if mib is None:
        return "n/a"
    return f"{mib / 1024:.1f}GiB"


def wrap_stats(stats: list[tuple[str, str]], width: int, indent: str = "  ") -> list[str]:
    """Pack `(label, value)` stat segments into lines that fit `width`.

    On a wide terminal everything lands on one line (identical to before);
    on a skinny pane the segments flow onto as many lines as needed.
    """
    sep = "   "
    avail = max(1, width - len(indent))
    lines: list[str] = []
    cur: list[str] = []
    cur_len = 0
    for k, v in stats:
        plain_len = len(k) + 1 + len(v)  # "label value"
        seg = f"{C.wrap(k, C.GREY)} {v}"
        extra = plain_len + (len(sep) if cur else 0)
        if cur and cur_len + extra > avail:
            lines.append(indent + sep.join(cur))
            cur, cur_len = [], 0
            extra = plain_len
        cur.append(seg)
        cur_len += extra
    if cur:
        lines.append(indent + sep.join(cur))
    return lines


def proc_section(procs: list[Proc], width: int, narrow: bool) -> list[str]:
    """Render the 'GPU processes' table as a list of lines."""
    lines = [C.wrap("GPU processes", C.BOLD)]
    if not procs:
        lines.append(C.wrap("  (none)", C.GREY))
        return lines
    ordered = sorted(procs, key=lambda x: (x.mem or 0), reverse=True)
    if narrow:
        # Drop the fixed column padding; truncate names to what's left.
        lines.append(C.wrap("  PID  MEM  PROCESS", C.GREY))
        for p in ordered:
            memstr = gib(p.mem)
            used = 2 + len(str(p.pid)) + 1 + len(memstr) + 1
            lines.append(f"  {p.pid} {memstr} {p.name[: max(0, width - used)]}")
    else:
        lines.append(C.wrap(f"  {'PID':>8}  {'MEM':>9}  PROCESS", C.GREY))
        for p in ordered:
            lines.append(
                f"  {p.pid:>8}  {gib(p.mem):>9}  {p.name[: max(0, width - 25)]}"
            )
    return lines


def _service_color(s: Service) -> str:
    if s.state == "failed":
        return C.RED
    if s.state in ("activating", "deactivating"):
        return C.YELLOW
    if s.state == "active":
        return C.GREEN if s.sub == "running" else C.GREY
    return C.GREY


def _service_glyph(s: Service) -> str:
    if s.state in ("activating", "deactivating"):
        return "◐"
    return "●" if s.state in ("failed", "active") and s.sub != "exited" else "○"


def service_section(services: list[Service], width: int, narrow: bool) -> list[str]:
    """Render the 'Services' table (your own systemd units) as a list of lines."""
    running = sum(1 for s in services if s.sub == "running")
    failed = sum(1 for s in services if s.state == "failed")
    tally = f"{running} up"
    if failed:
        tally += f", {failed} failed"
    lines = [C.wrap("Services", C.BOLD) + "  " + C.wrap(f"({tally})", C.GREY)]
    if not services:
        lines.append(C.wrap("  (none)", C.GREY))
        return lines
    name_w = max(4, min(28, max(len(s.short) for s in services)))   # >= "UNIT"
    stat_w = max(5, max(len(s.status) for s in services))           # >= "STATE"
    if narrow:
        lines.append(C.wrap("  UNIT  STATE", C.GREY))
        for s in services:
            col = _service_color(s)
            used = 4 + 1 + len(s.status)
            lines.append(
                f"  {C.wrap(_service_glyph(s), col)} "
                f"{s.short[: max(0, width - used)]} " + C.wrap(s.status, col)
            )
        return lines
    lines.append(
        C.wrap(f"    {'UNIT':<{name_w}}  {'SCOPE':<6}  {'STATE':<{stat_w}}  {'PID':>7}", C.GREY)
    )
    for s in services:
        col = _service_color(s)
        pid = s.pid if s.pid and s.pid != "0" else "-"
        lines.append(
            f"  {C.wrap(_service_glyph(s), col)} {s.short[:name_w]:<{name_w}}  "
            + C.wrap(f"{s.scope:<6}", C.GREY)
            + "  "
            + C.wrap(f"{s.status:<{stat_w}}", col)
            + "  "
            + C.wrap(f"{pid:>7}", C.GREY)
        )
    return lines


def port_section(listeners: list[Listener], width: int, narrow: bool) -> list[str]:
    """Render the 'Ports' table (listeners in the watched ranges) as lines."""
    public = sum(1 for l in listeners if l.public)
    tally = f"{len(listeners)} listening"
    if public:
        tally += f", {public} public"
    lines = [C.wrap("Ports", C.BOLD) + "  " + C.wrap(f"({tally})", C.GREY)]
    if not listeners:
        lines.append(C.wrap("  (nothing in the watched ranges)", C.GREY))
        return lines

    # tcp is the common case and goes unmarked; udp is called out.
    labels = {id(l): f"{l.port}/udp" if l.proto == "udp" else str(l.port) for l in listeners}
    port_w = max(4, max(len(v) for v in labels.values()))           # >= "PORT"
    bind_w = max(4, min(15, max(len(l.bind) for l in listeners)))   # >= "BIND"
    gap = " " if narrow else "  "
    lines.append(
        C.wrap(f"  {'PORT':>{port_w}}{gap}{'BIND':<{bind_w}}{gap}OWNER", C.GREY)
    )
    for l in listeners:
        port = f"{labels[id(l)]:>{port_w}}"
        bind = f"{l.bind[:bind_w]:<{bind_w}}"
        if l.container:
            tag = " ·docker"
        elif l.owner_kind == "unknown" and l.uid is not None:
            tag = " ·" + username(l.uid)  # at least say whose port it is
        else:
            tag = ""
        used = 2 + port_w + len(gap) + bind_w + len(gap) + len(tag)
        owner = (
            l.owner[: max(0, width - used)]
            if l.owner_kind != "unknown"
            else C.wrap("?", C.GREY)
        )
        lines.append(
            f"  {port}{gap}"
            + C.wrap(bind, C.YELLOW if l.public else C.GREY)
            + gap
            + owner
            + C.wrap(tag, C.GREY)
        )
    return lines


# A pane is only worth showing if it can fit its heading, its column header,
# one row of data, and the marker saying how much got cut.
MIN_PANE_ROWS = 4


def clip_pane(block: list[str], rows: int) -> list[str]:
    """Trim a rendered table to `rows` lines, noting how many were dropped."""
    if len(block) <= rows:
        return block
    keep = block[: max(1, rows - 1)]
    return keep + [C.wrap(f"  … +{len(block) - len(keep)} more", C.GREY)]


def render(
    gpus: list[Gpu],
    procs: list[Proc],
    width: int,
    height: int,
    interval: float,
    clear_eol: bool = False,
    services: list[Service] | None = None,
    listeners: list[Listener] | None = None,
) -> str:
    lines: list[str] = []
    host = os.uname().nodename
    now = time.strftime("%H:%M:%S")
    driver = gpus[0].driver if gpus else "?"
    narrow = width < 56
    title = C.wrap(" sparktop ", C.BOLD, C.CYAN)
    if narrow:
        # Stack the metadata so nothing runs off a skinny pane.
        lines.append(f"{title} {C.wrap(host, C.BOLD)}")
        lines.append(C.wrap(f"driver {driver}  every {interval}s  {now}", C.GREY))
    else:
        head = (
            f"{title} {C.wrap(host, C.BOLD)}  "
            f"{C.wrap('driver ' + driver, C.GREY)}  "
            f"{C.wrap('every ' + str(interval) + 's', C.GREY)}"
        )
        lines.append(head + "  " + C.wrap(now, C.GREY))
    lines.append(C.wrap("─" * width, C.GREY))

    # Wide: full bars with an external % readout. Narrow: drop the external %
    # (it's already centered inside the bar) and give the bar the room instead.
    if narrow:
        bar_w = max(10, min(40, width - 12))  # "  Compute " (10) + "[]" (2)
    else:
        bar_w = max(20, min(40, width - 36))
    for g in gpus:
        lines.append(
            C.wrap(f"GPU {g.index}", C.BOLD, C.BLUE)
            + " "
            + C.wrap(g.name, C.BOLD)
            + "  "
            + C.wrap(f"P-state {g.pstate}", C.GREY)
        )
        # Utilization
        u = g.util_gpu
        util_line = "  Compute " + bar(u, bar_w, f"{fmt(u, '%')}")
        if not narrow:
            util_line += "  " + C.wrap(
                fmt(u, "%"), color_for_pct(u) if u is not None else C.GREY
            )
        lines.append(util_line)
        # Memory
        mem_pct = (
            (g.mem_used / g.mem_total * 100)
            if g.mem_used is not None and g.mem_total
            else None
        )
        mem_inside = (
            gib(g.mem_used) if narrow
            else f"{gib(g.mem_used)}/{gib(g.mem_total)}"
        )
        mem_line = "  Memory  " + bar(mem_pct, bar_w, mem_inside)
        if not narrow:
            mem_line += "  " + C.wrap(
                fmt(mem_pct, "%"), color_for_pct(mem_pct) if mem_pct is not None else C.GREY
            )
        if g.mem_unified:
            mem_line += C.wrap(" unified", C.GREY)
        lines.append(mem_line)
        # Stats line
        pwr = fmt(g.power_draw, "W", 1)
        if g.power_limit:
            pwr += "/" + fmt(g.power_limit, "W", 0)
        stats = [
            ("temp", fmt(g.temp, "°C")),
            ("power", pwr),
            ("SM clk", fmt(g.clock_sm, "MHz")),
        ]
        lines.extend(wrap_stats(stats, width))
        lines.append("")

    # Everything below the GPU bars is secondary, in priority order. On a
    # short pane — e.g. a wide strip pinned to the top of a tmux layout — drop
    # whole tables from the bottom up so the GPU bars never scroll off the top.
    # The +2 reserves the blank + footer below; the strict `<` leaves one row
    # for the trailing newline in the live loop's write. `height <= 0` means
    # unbounded (one-shot snapshots show everything).
    blocks: list[list[str]] = []
    if services is not None:
        blocks.append(service_section(services, width, narrow))
    if listeners is not None:
        blocks.append(port_section(listeners, width, narrow))
    blocks.append(proc_section(procs, width, narrow))

    # Rows left for the panes. `lines` already ends in a blank row, which
    # separates the first one; the 2 reserves the blank + footer below, and
    # the extra 1 leaves a row for the live loop's trailing newline.
    avail = max(0, height - len(lines) - 3) if height > 0 else -1  # -1 = unbounded
    if avail >= 0:
        # Drop whole panes from the bottom (lowest priority) until the rest
        # can each show something, then share out what's left top-down.
        n = len(blocks)
        while n and n * MIN_PANE_ROWS + (n - 1) > avail:
            n -= 1
        blocks = blocks[:n]

    body: list[str] = []
    for i, block in enumerate(blocks):
        if avail < 0:
            body += ([""] if body else []) + block
            continue
        sep = 1 if body else 0
        reserve = (len(blocks) - i - 1) * (MIN_PANE_ROWS + 1)
        body += [""] * sep + clip_pane(block, avail - len(body) - sep - reserve)
    if body:
        lines += body
    elif lines and lines[-1] == "":
        lines.pop()  # avoid a double blank before the footer when all hidden

    lines.append("")
    lines.append(C.wrap("q / Ctrl-C to quit", C.GREY))
    eol = CLEAR_LINE if clear_eol else ""
    return "\n".join(line + eol for line in lines)


