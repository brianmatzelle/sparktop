# Data model
# ---------------------------------------------------------------------------
@dataclass
class Gpu:
    index: str
    name: str
    driver: str
    temp: float | None
    util_gpu: float | None
    util_mem: float | None
    mem_total: float | None  # MiB
    mem_used: float | None
    mem_free: float | None
    power_draw: float | None  # W
    power_limit: float | None
    clock_sm: float | None    # MHz
    pstate: str
    mem_unified: bool = False  # memory came from the shared system pool


@dataclass
class Proc:
    pid: str
    name: str
    mem: float | None  # MiB


@dataclass
class Service:
    """A systemd unit we consider 'yours' (see read_services)."""
    unit: str          # "garvis-bot.service"
    scope: str         # "system" | "user"
    state: str         # ActiveState, e.g. "active" / "failed"
    sub: str           # SubState, e.g. "running" / "exited"
    pid: str           # MainPID, "0" when there's no main process

    @property
    def short(self) -> str:
        return self.unit[: -len(".service")] if self.unit.endswith(".service") else self.unit

    @property
    def status(self) -> str:
        """The word we actually print: SubState is the informative half."""
        return self.sub or self.state


@dataclass
class Listener:
    """A socket bound to one of the watched dev ports."""
    port: int
    proto: str              # "tcp" | "udp"
    binds: set[str]         # raw local addresses seen for this port
    pid: str | None = None
    proc: str | None = None  # process name from ss (truncated to 15 chars)
    unit: str | None = None  # owning systemd unit, resolved via /proc/<pid>/cgroup
    container: str | None = None  # owning docker container, via `docker ps`
    uid: int | None = None  # socket owner, from /proc/net — set even when the
    #                         process itself is unidentifiable

    @property
    def owner(self) -> str:
        if self.unit:
            return self.unit[: -len(".service")] if self.unit.endswith(".service") else self.unit
        if self.container:
            return self.container
        return self.proc or "?"

    @property
    def owner_kind(self) -> str:
        if self.unit:
            return "unit"
        if self.container:
            return "docker"
        return "proc" if self.proc else "unknown"

    @property
    def bind(self) -> str:
        """One label for however many addresses this port is bound to.

        A wildcard bind subsumes the rest; otherwise a routable address is the
        interesting one, since that's what makes the port reachable off-box.
        """
        if any(b in ("0.0.0.0", "*", "::") for b in self.binds):
            return "*"
        routable = sorted(b for b in self.binds if not _loopback(b))
        return routable[0] if routable else "local"

    @property
    def public(self) -> bool:
        return self.bind != "local"


@dataclass
class Air:
    """One reading from an air-quality Feather on the USB port."""
    src: str | None          # which board sent it, e.g. "feather-1"
    age: float               # seconds since the line arrived
    co2: float | None        # ppm
    temp: float | None       # °C
    rh: float | None         # % relative humidity
    pm2p5: float | None      # µg/m³
    pm10: float | None       # µg/m³
    voc: float | None        # Sensirion VOC index, 1-500 (100 = baseline)
    nox: float | None        # Sensirion NOx index, 1-500 (1 = nothing there)
    pending: bool = False    # board is there, but hasn't published yet

    @property
    def stale(self) -> bool:
        return self.age > AIR_STALE_AFTER


@dataclass
class Docker:
    """What `docker ps` says about the running containers (see read_docker)."""
    ports: dict[int, str] = field(default_factory=dict)  # published host port -> name
